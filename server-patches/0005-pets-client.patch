+package romtg.pets
+{
+   import flash.utils.IDataOutput;
+   import kabam.rotmg.messaging.impl.outgoing.OutgoingMessage;
+
+   /** ROMTG-Doom pets: follow (1), unfollow (2) or release (3) one of your pets. */
+   public class ActivePetUpdateRequestMessage extends OutgoingMessage
+   {
+      public var command:int;
+      public var petId:int;
+
+      public function ActivePetUpdateRequestMessage(id:uint, callback:Function)
+      {
+         super(id, callback);
+      }
+
+      override public function writeToOutput(data:IDataOutput) : void
+      {
+         data.writeByte(this.command);
+         data.writeInt(this.petId);
+      }
+
+      override public function toString() : String
+      {
+         return formatToString("ACTIVE_PET_UPDATE_REQUEST", "command", "petId");
+      }
+   }
+}
