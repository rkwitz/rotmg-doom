+   import kabam.rotmg.messaging.impl.outgoing.OutgoingMessage;
+
+   /** ROMTG-Doom pets: feed a pet (2), fuse two (3), or grow the yard (1); paid in gold (0) or fame (1). */
+   public class PetUpgradeRequestMessage extends OutgoingMessage
+   {
+      public var transType:int;
+      public var petId1:int;
+      public var petId2:int;
+      public var objectId:int;
+      public var slotObjectId:int;
+      public var slotId:int;
+      public var slotObjectType:int;
+      public var currency:int = 0;
+
+      public function PetUpgradeRequestMessage(id:uint, callback:Function)
+      {
+         super(id, callback);
+      }
+
+      override public function writeToOutput(data:IDataOutput) : void
+      {
+         data.writeByte(this.transType);
+         data.writeInt(this.petId1);
+         data.writeInt(this.petId2);
+         data.writeInt(this.objectId);
+         data.writeInt(this.slotObjectId);
+         data.writeByte(this.slotId);
+         data.writeInt(this.slotObjectType);
+         data.writeByte(this.currency);
+      }
+
+      override public function toString() : String
+      {
+         return formatToString("PET_UPGRADE_REQUEST", "transType", "petId1", "petId2", "slotId");
+      }
+   }
+}
