+package romtg.pets
+{
+   import com.company.assembleegameclient.game.GameSprite;
+   import com.company.assembleegameclient.parameters.Parameters;
+   import com.company.assembleegameclient.ui.TextBox;
+   import com.company.assembleegameclient.ui.TextButton;
+   import com.company.assembleegameclient.ui.panels.Panel;
+   import com.company.ui.SimpleText;
+   import flash.events.Event;
+   import flash.events.KeyboardEvent;
+   import flash.events.MouseEvent;
+   import flash.filters.DropShadowFilter;
+   import flash.text.TextFieldAutoSize;
+
+   /** ROMTG-Doom: the Pet Upgrader's panel: opens your pets window. */
+   public class PetsPanel extends Panel
+   {
+      private var title_:SimpleText;
+      private var open_:TextButton;
+
+      public function PetsPanel(gs:GameSprite)
+      {
+         super(gs);
+         this.title_ = new SimpleText(18, 0xFFFFFF, false, WIDTH, 0);
+         this.title_.setBold(true);
+         this.title_.htmlText = "<p align=\"center\">Pet Upgrader</p>";
+         this.title_.autoSize = TextFieldAutoSize.CENTER;
+         this.title_.filters = [new DropShadowFilter(0, 0, 0)];
+         addChild(this.title_);
+         this.open_ = new TextButton(16, "Your Pets");
+         addChild(this.open_);
+         addEventListener(Event.ADDED_TO_STAGE, this.onAdded);
+         addEventListener(Event.REMOVED_FROM_STAGE, this.onRemoved);
+      }
+
+      private function onAdded(event:Event) : void
+      {
+         this.title_.y = 6;
+         this.open_.x = WIDTH / 2 - this.open_.width / 2;
+         this.open_.y = HEIGHT - this.open_.height - 4;
+         this.open_.addEventListener(MouseEvent.CLICK, this.onOpen);
+         stage.addEventListener(KeyboardEvent.KEY_DOWN, this.onKey);
+      }
+
+      private function onRemoved(event:Event) : void
+      {
+         stage.removeEventListener(KeyboardEvent.KEY_DOWN, this.onKey);
+      }
+
+      private function onKey(event:KeyboardEvent) : void
+      {
+         if (event.keyCode == Parameters.data_.interact && !TextBox.isInputtingText)
+         {
+            this.onOpen(null);
+         }
+      }
+
+      private function onOpen(event:MouseEvent) : void
+      {
+         PetsWindow.open(gs_);
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/pets/PetsWindow.as b/TK-Client/src/romtg/pets/PetsWindow.as
new file mode 100644
index 0000000..7b5c308
--- /dev/null
+++ b/TK-Client/src/romtg/pets/PetsWindow.as
@@ -0,0 +1,351 @@
+package romtg.pets
+{
+   import com.company.assembleegameclient.game.GameSprite;
+   import com.company.assembleegameclient.objects.GameObject;
+   import com.company.assembleegameclient.objects.ObjectLibrary;
+   import com.company.assembleegameclient.objects.Player;
+   import com.company.assembleegameclient.ui.TextButton;
+   import com.company.ui.SimpleText;
+   import flash.display.Bitmap;
+   import flash.display.BitmapData;
+   import flash.display.Sprite;
+   import flash.events.Event;
+   import flash.events.MouseEvent;
+   import flash.filters.DropShadowFilter;
+   import flash.geom.Point;
+   import flash.utils.getQualifiedClassName;
+   import romtg.DoomLink;
+
+   /**
+    * ROMTG-Doom: your pets, in the pet yard: every pet with its rarity and abilities, and what you
+    * can do with it: make it your active pet (it follows you out of the yard), feed it an item
+    * from your inventory, fuse it with another pet of the same rarity, or release it. Prices are
+    * the server's (NR-CORE's): gold.
+    */
+   public class PetsWindow extends Sprite
+   {
+      private static const W:int = 560;
+      // A row: the name on top, the abilities under it, the buttons on a line of their own at
+      // the bottom right (they sat over the abilities, 2026-11-12).
+      private static const ROW:int = 80;
+      private static const MAX_ROWS:int = 6;
+      private static var current:PetsWindow;
+
+      private var gs_:GameSprite;
+      private var rows_:Sprite = new Sprite();
+      private var status_:SimpleText;
+      private var mode_:String = "";         // "" | "feed" | "fuse"
+      private var picked_:RomtgPet;
+      private var first_:int = 0;
+
+      public static function open(gs:GameSprite) : void
+      {
+         if (current != null && current.parent != null)
+         {
+            current.parent.removeChild(current);
+         }
+         current = new PetsWindow(gs);
+         gs.addChild(current);
+         current.fit();
+      }
+
+      /** Centred over RotMG's play area (left of its side panel) and shrunk to fit it, whatever
+       *  the window's size: TK's stage is in window pixels and its game sprite may be scaled, so
+       *  a fixed place ran off the bottom of the screen (2026-11-12). */
+      private function fit() : void
+      {
+         if (stage == null || parent == null)
+         {
+            return;
+         }
+         var tl:Point = parent.globalToLocal(new Point(0, 0));
+         var br:Point = parent.globalToLocal(new Point(stage.stageWidth, stage.stageHeight));
+         var areaW:Number = (br.x - tl.x) * 0.75;   // the play area: the left 600 of RotMG's 800
+         var areaH:Number = br.y - tl.y;
+         var h:Number = 60 + ROW * MAX_ROWS + 50;
+         var s:Number = Math.min(1, (areaH - 20) / h, (areaW - 20) / W);
+         scaleX = scaleY = s;
+         x = tl.x + (areaW - W * s) / 2;
+         y = tl.y + (areaH - h * s) / 2;
+      }
+
+      public function PetsWindow(gs:GameSprite)
+      {
+         super();
+         this.gs_ = gs;
+         graphics.beginFill(0x2b2b2b, 0.96);
+         graphics.lineStyle(2, 0x777777);
+         graphics.drawRect(0, 0, W, 60 + ROW * MAX_ROWS + 50);
+         graphics.endFill();
+         var title:SimpleText = text(20, 0xFFFFFF, true);
+         title.text = "Your Pets";
+         title.updateMetrics();
+         title.x = 14;
+         title.y = 8;
+         addChild(title);
+         this.status_ = text(14, 0xB3B3B3, false);
+         this.status_.x = 14;
+         this.status_.y = 34;
+         addChild(this.status_);
+         this.rows_.y = 56;
+         addChild(this.rows_);
+         var close:TextButton = new TextButton(14, "Close");
+         close.x = W - close.width - 12;
+         close.y = 10;
+         close.addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void { closeWindow(); });
+         addChild(close);
+         var up:TextButton = new TextButton(14, "Up");
+         up.x = 14;
+         up.y = 60 + ROW * MAX_ROWS + 12;
+         up.addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void { first_ = Math.max(0, first_ - MAX_ROWS); refresh(); });
+         addChild(up);
+         var down:TextButton = new TextButton(14, "Down");
+         down.x = up.x + up.width + 8;
+         down.y = up.y;
+         down.addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void { first_ += MAX_ROWS; refresh(); });
+         addChild(down);
+         addEventListener(Event.ENTER_FRAME, this.onFrame);
+         this.refresh();
+      }
+
+      private var refreshAt:int = 0;
+
+      private function onFrame(event:Event) : void
+      {
+         // the yard's pets change (fed, fused, released): keep the list current
+         if (++this.refreshAt % 30 == 0)
+         {
+            this.refresh();
+         }
+      }
+
+      private function pets() : Array
+      {
+         var list:Array = [];
+         if (this.gs_ == null || this.gs_.map == null)
+         {
+            return list;
+         }
+         for each (var go:GameObject in this.gs_.map.goDict_)
+         {
+            var pet:RomtgPet = go as RomtgPet;
+            if (pet != null && pet.petId > 0)
+            {
+               list.push(pet);
+            }
+         }
+         list.sortOn("petId", Array.NUMERIC);
+         if (list.length == 0)
+         {
+            // Why none: every object here that is a pet by its XML, as the client holds it.
+            var seen:int = 0;
+            for each (var o:GameObject in this.gs_.map.goDict_)
+            {
+               if (o.props_ != null && ObjectLibrary.xmlLibrary_[o.objectType_] != null
+                   && String(ObjectLibrary.xmlLibrary_[o.objectType_].Class) == "Pet")
+               {
+                  seen++;
+                  var rp:RomtgPet = o as RomtgPet;
+                  DoomLink.log("pets window: object " + o.objectId_ + " type 0x" + o.objectType_.toString(16)
+                     + " is " + getQualifiedClassName(o) + (rp != null ? " petId " + rp.petId + " skin " + rp.skinType : ""));
+               }
+            }
+            DoomLink.log("pets window: no pets listed; " + seen + " pet objects in the map");
+         }
+         return list;
+      }
+
+      private function refresh() : void
+      {
+         while (this.rows_.numChildren > 0)
+         {
+            this.rows_.removeChildAt(0);
+         }
+         var list:Array = this.pets();
+         if (this.first_ >= list.length)
+         {
+            this.first_ = Math.max(0, list.length - MAX_ROWS);
+         }
+         if (this.mode_ == "feed")
+         {
+            this.status_.text = "Feed " + this.picked_.displayName + ": pick an item from your inventory below (5 gold).";
+         }
+         else if (this.mode_ == "fuse")
+         {
+            this.status_.text = "Fuse " + this.picked_.displayName + " with which " + this.picked_.rarityName + " pet?";
+         }
+         else
+         {
+            this.status_.text = list.length == 0 ? "No pets yet: hatch an egg (use it from your inventory)." : list.length + " pets";
+         }
+         this.status_.updateMetrics();
+         if (this.mode_ == "feed")
+         {
+            this.showInventory();
+            return;
+         }
+         for (var i:int = 0; i < MAX_ROWS && this.first_ + i < list.length; i++)
+         {
+            this.rows_.addChild(this.row(list[this.first_ + i], i));
+         }
+      }
+
+      private function row(pet:RomtgPet, i:int) : Sprite
+      {
+         var r:Sprite = new Sprite();
+         r.y = i * ROW;
+         r.graphics.beginFill(i % 2 == 0 ? 0x363636 : 0x303030);
+         r.graphics.drawRect(8, 0, W - 16, ROW - 4);
+         r.graphics.endFill();
+         var icon:BitmapData = pet.texture_ != null ? pet.texture_ : ObjectLibrary.getTextureFromType(pet.skinType || pet.objectType_);
+         if (icon != null)
+         {
+            var b:Bitmap = new Bitmap(icon);
+            b.scaleX = b.scaleY = 40 / Math.max(icon.width, icon.height);
+            b.x = 14;
+            b.y = 6;
+            r.addChild(b);
+         }
+         var name:SimpleText = text(16, rarityColor(pet.rarity), true);
+         var me:Player = this.gs_.map.player_;
+         var active:Boolean = me != null && pet.petId == RomtgPetCommands.activePetId;
+         name.text = pet.displayName + "  (" + pet.rarityName + ")" + (active ? "  - following you" : "");
+         name.updateMetrics();
+         name.x = 62;
+         name.y = 4;
+         r.addChild(name);
+         var abilities:SimpleText = text(13, 0xCCCCCC, false);
+         var parts:Array = [];
+         for (var a:int = 0; a < 3; a++)
+         {
+            var t:String = pet.abilityText(a);
+            if (t != "")
+            {
+               parts.push(t);
+            }
+         }
+         abilities.text = parts.join("   ") + "   (max level " + pet.maxLevel + ")";
+         abilities.updateMetrics();
+         abilities.x = 62;
+         abilities.y = 26;
+         r.addChild(abilities);
+
+         var bx:Number = W - 14;
+         if (this.mode_ == "fuse")
+         {
+            if (pet != this.picked_ && pet.rarity == this.picked_.rarity && pet.rarity < 4)
+            {
+               bx = button(r, bx, "Fuse into it", function():void {
+                  RomtgPetCommands.fuse(gs_, picked_.petId, pet.petId);
+                  mode_ = "";
+                  refresh();
+               });
+            }
+            button(r, bx, "Cancel", function():void { mode_ = ""; refresh(); });
+            return r;
+         }
+         bx = button(r, bx, "Release", function():void {
+            RomtgPetCommands.release(gs_, pet.petId);
+         });
+         if (pet.rarity < 4)
+         {
+            bx = button(r, bx, "Fuse", function():void { mode_ = "fuse"; picked_ = pet; refresh(); });
+         }
+         bx = button(r, bx, "Feed", function():void { mode_ = "feed"; picked_ = pet; refresh(); });
+         button(r, bx, active ? "Unfollow" : "Follow", function():void {
+            if (active)
+               RomtgPetCommands.unfollow(gs_, pet.petId);
+            else
+               RomtgPetCommands.follow(gs_, pet.petId);
+         });
+         return r;
+      }
+
+      /** Feeding: your inventory's items as buttons; a click feeds the picked pet that item. */
+      private function showInventory() : void
+      {
+         var me:Player = this.gs_.map.player_;
+         if (me == null)
+         {
+            return;
+         }
+         var col:int = 0, line:int = 0;
+         for (var slot:int = 4; slot < me.equipment_.length && slot < 20; slot++)
+         {
+            var type:int = me.equipment_[slot];
+            if (type <= 0)
+            {
+               continue;
+            }
+            var b:TextButton = new TextButton(13, String(ObjectLibrary.typeToDisplayId_[type] || type).substr(0, 22), 170);
+            b.x = 14 + col * 178;
+            b.y = line * 30;
+            b.addEventListener(MouseEvent.CLICK, feeder(slot, type));
+            this.rows_.addChild(b);
+            if (++col == 3)
+            {
+               col = 0;
+               line++;
+            }
+         }
+         var cancel:TextButton = new TextButton(14, "Cancel");
+         cancel.x = 14;
+         cancel.y = (line + 1) * 30 + 6;
+         cancel.addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void { mode_ = ""; refresh(); });
+         this.rows_.addChild(cancel);
+      }
+
+      private function feeder(slot:int, type:int) : Function
+      {
+         return function(e:MouseEvent):void
+         {
+            RomtgPetCommands.feed(gs_, picked_.petId, gs_.map.player_.objectId_, slot, type);
+            mode_ = "";
+            refresh();
+         };
+      }
+
+      private static function button(r:Sprite, right:Number, label:String, act:Function) : Number
+      {
+         var b:TextButton = new TextButton(13, label);
+         b.x = right - b.width;
+         b.y = ROW - 4 - b.height - 3;
+         b.addEventListener(MouseEvent.CLICK, function(e:MouseEvent):void { act(); });
+         r.addChild(b);
+         return b.x - 6;
+      }
+
+      private static function text(size:int, color:uint, bold:Boolean) : SimpleText
+      {
+         var t:SimpleText = new SimpleText(size, color, false, 0, 0);
+         t.setBold(bold);
+         t.filters = [new DropShadowFilter(0, 0, 0)];
+         return t;
+      }
+
+      private static function rarityColor(rarity:int) : uint
+      {
+         switch (rarity)
+         {
+            case 1: return 0x7ED957;   // uncommon
+            case 2: return 0x4FA3FF;   // rare
+            case 3: return 0xC77DFF;   // legendary
+            case 4: return 0xFFC93C;   // divine
+         }
+         return 0xFFFFFF;
+      }
+
+      private function closeWindow() : void
+      {
+         removeEventListener(Event.ENTER_FRAME, this.onFrame);
+         if (parent != null)
+         {
+            parent.removeChild(this);
+         }
+         if (current == this)
+         {
+            current = null;
+         }
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/pets/RomtgPet.as b/TK-Client/src/romtg/pets/RomtgPet.as
new file mode 100644
index 0000000..6afbd1e
--- /dev/null
+++ b/TK-Client/src/romtg/pets/RomtgPet.as
@@ -0,0 +1,100 @@
+package romtg.pets
+{
+   import com.company.assembleegameclient.objects.GameObject;
+   import com.company.assembleegameclient.objects.ObjectLibrary;
+   import com.company.assembleegameclient.objects.TextureData;
+   import com.company.assembleegameclient.game.GameSprite;
+   import com.company.assembleegameclient.objects.IInteractiveObject;
+   import com.company.assembleegameclient.ui.panels.Panel;
+
+   /**
+    * ROMTG-Doom: one of RotMG's pets (XML Class "Pet"), as the server (ported from NR-CORE) sends
+    * it: which of your pets it is, its rarity, its three abilities, and its look (a PetSkin's
+    * picture, swapped in when the server says which).
+    */
+   public class RomtgPet extends GameObject implements IInteractiveObject
+   {
+      public static const RARITIES:Array = ["Common", "Uncommon", "Rare", "Legendary", "Divine"];
+
+      public var petId:int = 0;
+      public var petType:int = 0;
+      public var rarity:int = 0;
+      public var skinName:String = "";
+      public var skinType:int = 0;
+      public var maxLevel:int = 0;
+      public var abilityType:Array = [0, 0, 0];
+      public var abilityLevel:Array = [0, 0, 0];
+      public var abilityPower:Array = [0, 0, 0];
+
+      public function RomtgPet(objectXML:XML)
+      {
+         super(objectXML);
+      }
+
+      /** A pet stat (StatData.PET_*); false if it isn't one. */
+      public function setPetStat(stat:int, value:int, text:String) : Boolean
+      {
+         switch (stat)
+         {
+            case 180:
+               this.petId = value;
+               isInteractive_ = value > 0;   // one of your pets: walk up to it to have it follow you
+               return true;
+            case 181: this.petType = value; return true;
+            case 182: this.rarity = value; return true;
+            case 183: this.skinName = text; return true;
+            case 184: this.maxLevel = value; return true;
+            case 185: case 186: case 187: this.abilityPower[stat - 185] = value; return true;
+            case 188: case 189: case 190: this.abilityLevel[stat - 188] = value; return true;
+            case 191: case 192: case 193: this.abilityType[stat - 191] = value; return true;
+            case 194:
+               if (value != this.skinType)
+               {
+                  this.skinType = value;
+                  this.applySkin(value);
+               }
+               return true;
+         }
+         return false;
+      }
+
+      private function applySkin(type:int) : void
+      {
+         var data:TextureData = ObjectLibrary.typeToTextureData_[type];
+         if (data == null)
+         {
+            return;
+         }
+         texture_ = data.texture_;
+         mask_ = data.mask_;
+         animatedChar_ = data.animatedChar_;
+      }
+
+      public function getPanel(gs:GameSprite) : Panel
+      {
+         return new PetPanel(gs, this);
+      }
+
+      public function get rarityName() : String
+      {
+         return this.rarity >= 0 && this.rarity < RARITIES.length ? RARITIES[this.rarity] : "?";
+      }
+
+      public function get displayName() : String
+      {
+         return this.skinName != null && this.skinName != "" ? this.skinName : ObjectLibrary.typeToDisplayId_[objectType_];
+      }
+
+      /** "Heal 12" for ability i, or "" if the pet hasn't unlocked it. */
+      public function abilityText(i:int) : String
+      {
+         var type:int = this.abilityType[i];
+         if (type == 0 || this.abilityLevel[i] <= 0)
+         {
+            return "";
+         }
+         var name:String = ObjectLibrary.typeToDisplayId_[type] || ("Ability " + type);
+         return name.replace(" (RotMG Pet)", "") + " " + this.abilityLevel[i];
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/pets/RomtgPetCommands.as b/TK-Client/src/romtg/pets/RomtgPetCommands.as
new file mode 100644
index 0000000..67d6ab8
--- /dev/null
+++ b/TK-Client/src/romtg/pets/RomtgPetCommands.as
@@ -0,0 +1,44 @@
+package romtg.pets
+{
+   import com.company.assembleegameclient.game.GameSprite;
+
+   /** ROMTG-Doom pets: what the pets window asks the server (through GameServerConnection), and
+    *  which pet is your active one. */
+   public class RomtgPetCommands
+   {
+      public static const FOLLOW:int = 1;
+      public static const UNFOLLOW:int = 2;
+      public static const RELEASE:int = 3;
+      public static const UPGRADE_YARD:int = 1;
+      public static const FEED:int = 2;
+      public static const FUSE:int = 3;
+
+      /** Your active pet's id, as the server last said (-1/0: none). */
+      public static var activePetId:int = 0;
+
+      public static function follow(gs:GameSprite, petId:int) : void
+      {
+         gs.gsc_.romtgPetCommand(FOLLOW, petId);
+      }
+
+      public static function unfollow(gs:GameSprite, petId:int) : void
+      {
+         gs.gsc_.romtgPetCommand(UNFOLLOW, petId);
