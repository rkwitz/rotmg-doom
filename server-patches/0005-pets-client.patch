diff --git a/TK-Client/src/romtg/pets/PetPanel.as b/TK-Client/src/romtg/pets/PetPanel.as
new file mode 100644
index 0000000..526185c
--- /dev/null
+++ b/TK-Client/src/romtg/pets/PetPanel.as
@@ -0,0 +1,81 @@
+package romtg.pets
+{
+   import com.company.assembleegameclient.game.GameSprite;
+   import com.company.assembleegameclient.parameters.Parameters;
+   import com.company.assembleegameclient.ui.TextBox;
+   import com.company.assembleegameclient.ui.TextButton;
+   import com.company.assembleegameclient.ui.panels.Panel;
+   import com.company.ui.SimpleText;
+   import flash.events.Event;
+   import flash.events.KeyboardEvent;
+   import flash.events.MouseEvent;
+   import flash.filters.DropShadowFilter;
+   import flash.text.TextFieldAutoSize;
+
+   /** ROMTG-Doom: walk up to one of your pets (in your pet yard) to have it follow you, or stop
+    *  following: its name and rarity, and a Follow / Unfollow button (or the interact key). */
+   public class PetPanel extends Panel
+   {
+      private var pet_:RomtgPet;
+      private var title_:SimpleText;
+      private var button_:TextButton;
+      private var following_:Boolean;
+
+      public function PetPanel(gs:GameSprite, pet:RomtgPet)
+      {
+         super(gs);
+         this.pet_ = pet;
+         this.title_ = new SimpleText(16, 0xFFFFFF, false, WIDTH, 0);
+         this.title_.setBold(true);
+         this.title_.htmlText = "<p align=\"center\">" + pet.displayName + " (" + pet.rarityName + ")</p>";
+         this.title_.autoSize = TextFieldAutoSize.CENTER;
+         this.title_.filters = [new DropShadowFilter(0, 0, 0)];
+         addChild(this.title_);
+         this.following_ = pet.petId == RomtgPetCommands.activePetId;
+         this.button_ = new TextButton(16, this.following_ ? "Unfollow" : "Follow");
+         addChild(this.button_);
+         addEventListener(Event.ADDED_TO_STAGE, this.onAdded);
+         addEventListener(Event.REMOVED_FROM_STAGE, this.onRemoved);
+      }
+
+      private function onAdded(event:Event) : void
+      {
+         this.title_.y = 6;
+         this.button_.x = WIDTH / 2 - this.button_.width / 2;
+         this.button_.y = HEIGHT - this.button_.height - 4;
+         this.button_.addEventListener(MouseEvent.CLICK, this.onClick);
+         stage.addEventListener(KeyboardEvent.KEY_DOWN, this.onKey);
+      }
+
+      private function onRemoved(event:Event) : void
+      {
+         if (stage != null)
+         {
+            stage.removeEventListener(KeyboardEvent.KEY_DOWN, this.onKey);
+         }
+      }
+
+      private function onKey(event:KeyboardEvent) : void
+      {
+         if (event.keyCode == Parameters.data_.interact && !TextBox.isInputtingText)
+         {
+            this.onClick(null);
+         }
+      }
+
+      private function onClick(event:MouseEvent) : void
+      {
+         if (this.following_)
+         {
+            RomtgPetCommands.unfollow(gs_, this.pet_.petId);
+         }
+         else
+         {
+            RomtgPetCommands.follow(gs_, this.pet_.petId);
+         }
+         this.following_ = !this.following_;
+         this.button_.setText(this.following_ ? "Unfollow" : "Follow");
+         this.button_.x = WIDTH / 2 - this.button_.width / 2;
+      }
+   }
+}
