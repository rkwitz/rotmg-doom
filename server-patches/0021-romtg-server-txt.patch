 package kabam.rotmg.application.impl {
 import com.company.assembleegameclient.parameters.Parameters;
 
+import flash.filesystem.File;
+import flash.filesystem.FileMode;
+import flash.filesystem.FileStream;
+
 import kabam.rotmg.application.api.ApplicationSetup;
 
 public class LocalhostSetup implements ApplicationSetup {
-    private const LOCALHOST:String = "http://127.0.0.1:2000";
+    // ROMTG-Doom: the server is this PC unless a `server.txt` next to the client names another
+    // (one line, a host or IP: the friend demo's package, 2026-11-15). The game server is then
+    // reached at that same host too (LiveServerModel), whatever address the server lists.
+    private static var host_:String = null;
+
+    public static function serverHost():String {
+        if (host_ == null) {
+            host_ = "127.0.0.1";
+            try {
+                var f:File = File.applicationDirectory.resolvePath("server.txt");
+                if (f.exists) {
+                    var s:FileStream = new FileStream();
+                    s.open(f, FileMode.READ);
+                    var text:String = s.readUTFBytes(s.bytesAvailable);
+                    s.close();
+                    text = text.replace(/^\s+|\s+$/g, "");
+                    if (text.length > 0) {
+                        host_ = text;
+                    }
+                }
+            }
+            catch (e:Error) {
+            }
+        }
+        return host_;
+    }
+
+    private const LOCALHOST:String = "http://" + serverHost() + ":2000";
