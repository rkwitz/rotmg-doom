diff --git a/TK-Client/src/kabam/rotmg/ui/view/CameraButton.as b/TK-Client/src/kabam/rotmg/ui/view/CameraButton.as
new file mode 100644
index 0000000..67fa62a
--- /dev/null
+++ b/TK-Client/src/kabam/rotmg/ui/view/CameraButton.as
@@ -0,0 +1,69 @@
+package kabam.rotmg.ui.view
+{
+   import flash.display.Graphics;
+   import flash.display.Sprite;
+   import flash.events.MouseEvent;
+   import flash.filters.GlowFilter;
+   import romtg.DoomLink;
+
+   /**
+    * ROMTG-Doom: first person <-> third person in Doom, left of the Doom button in the side
+    * panel (Ryan, 2026-11-20). A small camera drawn in the Doom button's orange. A click asks
+    * the bridge (rotmg-doom/scripts/bridge.py) to switch Doom's camera; the key for it is in
+    * Options (romtgCamera, C by default).
+    */
+   public class CameraButton extends Sprite
+   {
+      private static const COLOR:uint = 0xFF8C26;
+      private static const OVER:uint = 0xFFCC66;
+
+      public function CameraButton()
+      {
+         super();
+         this.draw(COLOR);
+         filters = [new GlowFilter(0, 1, 3, 3, 8)];
+         buttonMode = true;
+         useHandCursor = true;
+         addEventListener(MouseEvent.CLICK, this.onClick);
+         addEventListener(MouseEvent.ROLL_OVER, this.onOver);
+         addEventListener(MouseEvent.ROLL_OUT, this.onOut);
+      }
+
+      /** About the nexus icon's size (40 units): a camera body, its lens and viewfinder. */
+      private function draw(color:uint) : void
+      {
+         var g:Graphics = graphics;
+         g.clear();
+         g.beginFill(0, 0);   // the whole square is clickable
+         g.drawRect(0, 0, 40, 40);
+         g.endFill();
+         g.beginFill(color);
+         g.drawRoundRect(5, 12, 30, 20, 6, 6);
+         g.drawRect(12, 8, 10, 5);
+         g.endFill();
+         g.beginFill(0x1E1E1E);
+         g.drawCircle(20, 22, 7);
+         g.endFill();
+         g.beginFill(color);
+         g.drawCircle(20, 22, 4);
+         g.endFill();
+      }
+
+      private function onOver(event:MouseEvent) : void
+      {
+         this.draw(OVER);
+      }
+
+      private function onOut(event:MouseEvent) : void
+      {
+         this.draw(COLOR);
+      }
+
+      private function onClick(event:MouseEvent) : void
+      {
+         event.stopImmediatePropagation();
+         DoomLink.send("camtoggle");
+         DoomLink.flush();
+      }
+   }
+}
