+      /** ROMTG-Doom: the camera, Doom and nexus icons in a row, right to left from where the
+       *  nexus icon ends, all the same height by what they actually draw (not their padded
+       *  pictures: the Doom arrows fill little of theirs), in the gap between the tab strip's
+       *  tabs (inventory, stats, backpack, talismans) and the panel's edge. As tall as the
+       *  nexus icon if all three fit, all a little smaller if not; never over the talismans tab
+       *  (Ryan, 2026-11-21). */
+      private function layoutIconRow() : void
+      {
+         var nexus:Bitmap = this.nexusIndicatorBitmap_;
+         var nexusR:Rectangle = nexus.bitmapData.getColorBoundsRect(0xFF000000, 0, false);
+         var doomR:Rectangle = this.doomButton.visualRect();
+         var camR:Rectangle = CameraButton.VISUAL;
+         var right:Number = nexus.x + nexusR.right;
+         var middle:Number = nexus.y + nexusR.y + nexusR.height / 2;
+         var left:Number = this.TAB_STRIP_POSITION.x + 4 * (TabStripView.TAB_WIDTH + TabStripView.TAB_X_PADDING) + 3;
+         var gap:Number = 4;
+         var aspects:Number = nexusR.width / nexusR.height + doomR.width / doomR.height + camR.width / camR.height;
+         var h:Number = Math.min(nexusR.height, (right - left - 2 * gap) / aspects);
+         var x:Number = right;
+         x = this.placeIcon(nexus, nexusR, h, x, middle) - gap;
+         x = this.placeIcon(this.doomButton, doomR, h, x, middle) - gap;
+         this.placeIcon(this.cameraButton, camR, h, x, middle);
+      }
+
+      /** Scales ICON so the part it draws (R, in its own units) is H tall, with that part's right
+       *  edge at RIGHT and its middle at MIDDLE; returns that part's left edge. */
+      private function placeIcon(icon:DisplayObject, r:Rectangle, h:Number, right:Number, middle:Number) : Number
+      {
+         var s:Number = h / r.height;
+         icon.scaleX = icon.scaleY = s;
+         icon.x = right - r.right * s;
+         icon.y = middle - (r.y + r.height / 2) * s;
+         return icon.x + r.x * s;
       }
 
