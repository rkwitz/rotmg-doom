+      private static var interactUntil:int = 0;
+      private static const INTERACT_WAIT_MS:int = 700;
+
+      /** Presses RotMG's interact key if its interact panel has something to use now. */
+      private static function interactNow() : Boolean
+      {
+         if (map == null || map.gs_ == null || map.gs_.stage == null || map.gs_.hudView == null
+             || map.gs_.hudView.interactPanel == null)
+         {
+            return false;
+         }
+         var panel:Object = map.gs_.hudView.interactPanel;
+         panel.draw();
+         if (panel.currObj_ == null)
+         {
+            return false;
+         }
+         var code:uint = Parameters.data_.interact;
+         map.gs_.stage.dispatchEvent(new KeyboardEvent(KeyboardEvent.KEY_DOWN, true, false, 0, code));
+         map.gs_.stage.dispatchEvent(new KeyboardEvent(KeyboardEvent.KEY_UP, true, false, 0, code));
+         return true;
+      }
