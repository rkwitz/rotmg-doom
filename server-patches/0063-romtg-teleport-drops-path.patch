+      /** Doom's gotos are dropped until then (ms, getTimer): the server just moved you. */
+      private static var gotoQuietUntil:int = 0;
+      private static const GOTO_QUIET_MS:int = 300;
+      /** A goto this far from you (tiles) is from before a jump: Doom walks you a step at a time. */
+      private static const GOTO_MAX_TILES:Number = 3;
+
+      /** The server moved you (a teleport cloak, the Teleport menu, a portal's landing...: its
+       *  Goto). Doom's path and the gotos already on their way lead back to where you were, and
+       *  you were walked back there (Ryan, 2026-11-17, the rogue's teleport cloak). Forgotten;
+       *  Doom catches up from your next position report. */
+      public static function teleported() : void
+      {
+         gotoPath.length = 0;
+         hasGoto = false;
+         gotoQuietUntil = getTimer() + GOTO_QUIET_MS;
+      }
+
+      private static function staleGoto(x:Number, y:Number) : Boolean
+      {
+         if (getTimer() < gotoQuietUntil)
+         {
+            return true;
+         }
+         var player:Player = map != null ? map.player_ : null;
+         if (player == null)
+         {
+            return false;
+         }
+         var dx:Number = x - player.x_;
+         var dy:Number = y - player.y_;
+         return dx * dx + dy * dy > GOTO_MAX_TILES * GOTO_MAX_TILES;
+      }
+
