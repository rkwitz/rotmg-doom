diff --git a/TK-Server/TKR.WorldServer/logic/db/BehaviorDb.RomtgLab.cs b/TK-Server/TKR.WorldServer/logic/db/BehaviorDb.RomtgLab.cs
new file mode 100644
index 0000000..514c6a8
--- /dev/null
+++ b/TK-Server/TKR.WorldServer/logic/db/BehaviorDb.RomtgLab.cs
@@ -0,0 +1,62 @@
+using TKR.Shared.resources;
+using TKR.WorldServer.logic.behaviors;
+using TKR.WorldServer.logic.transitions;
+
+// ROMTG-Doom: the two Mad Lab enemies TK had no AI for, ported from alloy-server
+// (github.com/Zolmex/alloy-server, MIT, GameServer/.../BehaviorLib.MadLab.cs), into TK's
+// behaviour language. Mad Lab's full-size layout comes from alloy too (scripts/dungeons.py).
+// Projectiles are the Horrific Creation's own, from its XML: 1 Wave, 4 Energy, 5 Shockwave,
+// 6 Blast.
+namespace TKR.WorldServer.logic
+{
+    partial class BehaviorDb
+    {
+        private _ RomtgLab = () => Behav()
+        .Init("Horrific Creation",
+            new State(
+                new DropPortalOnDeath("Realm Portal", 1.0),
+                new State("wait",
+                    new ConditionEffectBehavior(ConditionEffectIndex.Invulnerable, true),
+                    new TimedTransition(2000, "taunt")
+                    ),
+                new State("taunt",
+                    new ConditionEffectBehavior(ConditionEffectIndex.Invulnerable, true),
+                    new Taunt("Terrible... no more... Only HORROR remains!"),
+                    new TimedTransition(2000, "jump")
+                    ),
+                new State("jump",
+                    new ConditionEffectBehavior(ConditionEffectIndex.Invulnerable, false, 2000),
+                    new Charge(2, 15, coolDown: 3000),
+                    new TimedTransition(1000, "p1")
+                    ),
+                new State("p1",
+                    new Taunt("RAHHHHHHH!"),
+                    // a ring of shockwaves as it lands
+                    new Shoot(15, count: 20, shootAngle: 18, projectileIndex: 5, coolDown: 100000, coolDownOffset: 100),
+                    new TimedTransition(1500, "p2")
+                    ),
+                new State("p2",
+                    new Prioritize(
+                        new Follow(0.6, 20, 3),
+                        new Wander(0.5)
+                        ),
+                    new Shoot(15, count: 5, shootAngle: 15, projectileIndex: 6, coolDown: 1000, coolDownOffset: 500),
+                    new Shoot(15, count: 10, shootAngle: 36, projectileIndex: 1, coolDown: 1500, coolDownOffset: 1000),
+                    new Shoot(15, count: 20, shootAngle: 18, projectileIndex: 4, coolDown: 5000, coolDownOffset: 3000),
+                    new TimedRandomTransition(8000, false, "jump", "p2")
+                    )
+                )
+            )
+        .Init("Mad Gas Controller",
+            new State(
+                new ConditionEffectBehavior(ConditionEffectIndex.Invincible, true),
+                new State("wait",
+                    new TimedTransition(20000, "gone")
+                    ),
+                new State("gone",
+                    new Suicide()
+                    )
+                )
+            );
+    }
+}
