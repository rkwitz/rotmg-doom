+      /** Where OBJ draws solid pixels (alpha over half), in its own units at scale 1, its own
+       *  filters (a glow outline) included. */
+      private static function solidRect(obj:DisplayObject) : Rectangle
+      {
+         var b:Rectangle = obj.getBounds(obj);
+         var pad:int = 8;
+         var w:int = Math.ceil(b.width) + 2 * pad;
+         var h:int = Math.ceil(b.height) + 2 * pad;
+         if (w <= 2 * pad || h <= 2 * pad)
+         {
+            return new Rectangle(0, 0, Math.max(1, b.width), Math.max(1, b.height));
+         }
+         var bd:BitmapData = new BitmapData(w, h, true, 0);
+         var m:Matrix = new Matrix();
+         m.translate(pad - b.x, pad - b.y);
+         bd.draw(obj, m);
+         if (obj.filters != null)
+         {
+            for each (var f:BitmapFilter in obj.filters)
+            {
+               bd.applyFilter(bd, bd.rect, new Point(0, 0), f);
+            }
+         }
+         var x0:int = w, y0:int = h, x1:int = -1, y1:int = -1;
+         for (var y:int = 0; y < h; y++)
+         {
+            for (var x:int = 0; x < w; x++)
+            {
+               if ((bd.getPixel32(x, y) >>> 24) > 128)
+               {
+                  if (x < x0) x0 = x;
+                  if (x > x1) x1 = x;
+                  if (y < y0) y0 = y;
+                  if (y > y1) y1 = y;
+               }
+            }
+         }
+         bd.dispose();
+         if (x1 < 0)
+         {
+            return new Rectangle(b.x, b.y, Math.max(1, b.width), Math.max(1, b.height));
+         }
+         return new Rectangle(x0 - pad + b.x, y0 - pad + b.y, x1 - x0 + 1, y1 - y0 + 1);
+      }
