+
+      /** The equipped ability's Activate that throws it at a spot, or null. */
+      private static function throwActivate(player:Player) : XML
+      {
+         if (player == null || player.equipment_ == null || player.equipment_[1] <= 0)
+         {
+            return null;
+         }
+         var xml:XML = ObjectLibrary.xmlLibrary_[player.equipment_[1]];
+         if (xml == null)
+         {
+            return null;
+         }
+         for each (var a:XML in xml.Activate)
+         {
+            if (THROWN.indexOf(a.toString()) >= 0)
+            {
+               return a;
+            }
+         }
+         return null;
+      }
+
+      private static function throwMax(a:XML) : Number
+      {
+         if (a.toString() == "Teleport")
+         {
+            return Math.min(TELEPORT_MAX, Number(a.@maxDistance) || TELEPORT_MAX);
+         }
+         return THROW_MAX;
+      }
+
+      /** Throw the held ability where Doom aims: throwDistance tiles along your aim, on that
+       *  square's middle (RotMG targets squares too: Map.pSTopW). */
+      private static function throwNow(player:Player) : void
+      {
+         var a:XML = throwActivate(player);
+         if (player == null || a == null)
+         {
+            return;
+         }
+         var d:Number = Math.max(THROW_MIN, Math.min(throwMax(a), throwDistance));
+         var x:Number = player.x_ + Math.cos(aim) * d;
+         var y:Number = player.y_ + Math.sin(aim) * d;
+         if (map != null)
+         {
+            x = Math.max(0, Math.min(map.width_ - 1, x));
+            y = Math.max(0, Math.min(map.height_ - 1, y));
+         }
+         abilityTarget = new Point(int(x) + 0.5, int(y) + 0.5);
+         try
+         {
+            if (player.useAltWeapon(abilityX(), abilityY(), UseType.START_USE))
+            {
+               player.useAltWeapon(abilityX(), abilityY(), UseType.END_USE);
+            }
+         }
+         finally
+         {
+            abilityTarget = null;
+         }
+      }
+
