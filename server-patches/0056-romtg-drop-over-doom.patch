       // shows meanwhile so the item can be dropped on it).
       public static var draggingNow:Boolean = false;
+      // ROMTG-Doom: the tile being dragged, and the drop it ends in made "on the ground" (let go
+      // over Doom, where RotMG never sees the mouse: doomDrop).
+      public static var dragged:InteractiveItemTile = null;
+      public static var dropOnGround:Boolean = false;
+
+      /** ROMTG-Doom: the item being dragged let go over Doom (romtg.DoomLink `dragdrop`): dropped
+       *  on the ground, as letting go over RotMG's own does. */
+      public static function doomDrop() : void
+      {
+         var tile:InteractiveItemTile = dragged;
+         if (tile == null || !tile.isDragging)
+         {
+            return;
+         }
+         dropOnGround = true;
+         try
+         {
+            tile.endDrag(null);
+         }
+         finally
+         {
+            dropOnGround = false;
+         }
+      }
       
