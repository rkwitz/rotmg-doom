diff --git a/TK-Client/src/kabam/rotmg/ui/view/DoomButton.as b/TK-Client/src/kabam/rotmg/ui/view/DoomButton.as
new file mode 100644
index 0000000..955bc89
--- /dev/null
+++ b/TK-Client/src/kabam/rotmg/ui/view/DoomButton.as
@@ -0,0 +1,56 @@
+package kabam.rotmg.ui.view
+{
+   import com.company.assembleegameclient.util.TextureRedrawer;
+   import com.company.util.AssetLibrary;
+   import flash.display.Bitmap;
+   import flash.display.BitmapData;
+   import flash.display.Sprite;
+   import flash.events.MouseEvent;
+   import flash.geom.ColorTransform;
+   import romtg.DoomLink;
+
+   /**
+    * ROMTG-Doom: the swap-to-Doom icon, left of the nexus icon in the side panel and drawn the
+    * same way (an icon from lofiInterfaceBig, outlined and tinted). A click asks the swapper
+    * (rotmg-doom/scripts/duo.py) to bring Doom up, over the client's link to it (DoomLink).
+    * Does nothing when the swapper isn't running.
+    */
+   public class DoomButton extends Sprite
+   {
+      /** lofiInterfaceBig's swap arrows. */
+      private static const ICON:int = 7;
+
+      private var icon:Bitmap;
+
+      public function DoomButton()
+      {
+         super();
+         var bitmapData:BitmapData = AssetLibrary.getImageFromSet("lofiInterfaceBig", ICON);
+         this.icon = new Bitmap(TextureRedrawer.redraw(bitmapData, 320 / bitmapData.width, true, 0));
+         this.icon.transform.colorTransform = new ColorTransform(1, 0.55, 0.15);
+         addChild(this.icon);
+         buttonMode = true;
+         useHandCursor = true;
+         addEventListener(MouseEvent.CLICK, this.onClick);
+         addEventListener(MouseEvent.ROLL_OVER, this.onOver);
+         addEventListener(MouseEvent.ROLL_OUT, this.onOut);
+      }
+
+      private function onOver(event:MouseEvent) : void
+      {
+         this.icon.transform.colorTransform = new ColorTransform(1, 0.8, 0.4);
+      }
+
+      private function onOut(event:MouseEvent) : void
+      {
+         this.icon.transform.colorTransform = new ColorTransform(1, 0.55, 0.15);
+      }
+
+      private function onClick(event:MouseEvent) : void
+      {
+         event.stopImmediatePropagation();
+         DoomLink.send("swap");
+         DoomLink.flush();
+      }
+   }
+}
