diff --git a/TK-Client/src/romtg/DoomLink.as b/TK-Client/src/romtg/DoomLink.as
new file mode 100644
index 0000000..3bf3eb0
--- /dev/null
+++ b/TK-Client/src/romtg/DoomLink.as
@@ -0,0 +1,652 @@
+package romtg
+{
+   import com.company.assembleegameclient.map.Map;
+   import com.company.assembleegameclient.map.Square;
+   import com.company.assembleegameclient.objects.BasicObject;
+   import com.company.assembleegameclient.objects.GameObject;
+   import com.company.assembleegameclient.objects.Player;
+   import com.company.assembleegameclient.objects.Projectile;
+   import com.company.assembleegameclient.map.mapoverlay.CharacterStatusText;
+   import com.company.assembleegameclient.parameters.Parameters;
+   import flash.display.DisplayObject;
+   import flash.events.Event;
+   import flash.geom.Rectangle;
+   import flash.events.IOErrorEvent;
+   import flash.events.KeyboardEvent;
+   import flash.events.ProgressEvent;
+   import flash.events.SecurityErrorEvent;
+   import flash.net.Socket;
+   import flash.utils.Dictionary;
+   import flash.utils.getTimer;
+   import kabam.rotmg.constants.UseType;
+   import romtg.pets.RomtgPet;
+
+   /**
+    * ROMTG-Doom: the client's line to the swapper (rotmg-doom/scripts/duo.py, 127.0.0.1:2051),
+    * which passes the realm on to Doom and Doom's controls back.
+    *
+    * Client to swapper, one line each (positions in tiles):
+    *   map NAME W H          a new map; everything before it is gone
+    *   t X Y TYPE            ground tile X,Y is TYPE
+    *   o ID TYPE X Y SIZE S [HP MAX]  an object appeared (S: 1 static, 0 moves); SIZE in
+    *                         percent; HP and MAX for enemies (their health bar)
+    *   u ID X Y [HP MAX]     a moving object moved (or an enemy's health changed)
+    *   r ID                  object ID is gone
+    *   j ID TYPE X Y SIZE    a projectile appeared (TYPE: its picture's object type)
+    *   uj ID X Y             a projectile moved
+    *   rj ID                 projectile ID is gone
+    *   p X Y SPEED           where you are, and your base speed in tiles per second
+    *   w TYPE                the weapon you hold (-1: none)
+    *   me ID                 your own object's id (never drawn: you are Doom's camera)
+    *   quest ID X Y HP MAX NAME | quest -1   the quest (boss) RotMG points you to, or none
+    *   cash CREDITS FAME     your gold and fame
+    *   tip X Y W H | tip -   a tooltip is showing at X Y W H (RotMG stage units), or none
+    *   st COLOR TEXT         a status text over you (XP gained, level up, quest complete...)
+    *   chat NC TC NAME<tab>TO<tab>TEXT       a chat line (NC/TC: name and text colours)
+    *   swap                  the Doom button
+    * Swapper to client:
+    *   ctl 1|0               Doom has the controls (1) or RotMG does (0)
+    *   m X Y                 while Doom has them: the way to walk, a vector of length 0..1
+    *   fire 1|0 ANGLE        holding fire or not; ANGLE is where Doom looks (radians, RotMG world:
+    *                         x right, y down), also used to aim the ability
+    *   act NAME              press RotMG's key for NAME (Parameters.data_ name, e.g. useHealthPotion)
+    *   view 1|0              Doom is on screen (1): RotMG's own HUD over the play area (chat, boss
+    *                         bar, gold and fame, status texts, quest arrow) is hidden, Doom draws it
+    *
+    * Doom only chooses directions and presses keys: the client walks, shoots and uses items
+    * itself, at its own speed and rate of fire, so the server sees normal play.
+    */
+   public class DoomLink
+   {
+      public static const PORT:int = 2051;
+      private static const RETRY_MS:int = 2000;
+      private static const POS_MS:int = 15;
+      private static const OBJECTS_MS:int = 40;
+      private static const PROJECTILES_MS:int = 30;
+      /** How far ahead of you an ability lands, in RotMG screen pixels (50 to a tile). */
+      private static const ABILITY_REACH:Number = 200;
+
+      public static var controlling:Boolean = false;
+      public static var viewing:Boolean = false;
+      private static const HUD_MS:int = 100;
+      private static var hudAt:int = 0;
+      private static var lastQuest:String = "";
+      private static var lastCash:String = "";
+      public static var moveX:Number = 0;
+      public static var moveY:Number = 0;
+      public static var firing:Boolean = false;
+      /** Where Doom aims, in RotMG world radians. */
+      public static var aim:Number = 0;
+
+      private static var socket:Socket;
+      private static var retryAt:int = 0;
+      private static var incoming:String = "";
+      private static var map:Map;
+      private static var posAt:int = 0;
+      private static var objectsAt:int = 0;
+      private static var projectilesAt:int = 0;
+      private static var lastX:Number = NaN;
+      private static var lastY:Number = NaN;
+      private static var weapon:int = -2;
+      private static var me:int = -1;
+      private static var seen:Dictionary = new Dictionary();
+      private static var seenShots:Dictionary = new Dictionary();
+
+      public static function newMap(m:Map) : void
+      {
+         map = m;
+         lastX = NaN;
+         weapon = -2;
+         lastQuest = lastCash = "";
+         seen = new Dictionary();
+         seenShots = new Dictionary();
+         send("map " + clean(m.name_) + " " + m.width_ + " " + m.height_);
+      }
+
+      public static function tile(x:int, y:int, type:uint) : void
+      {
+         send("t " + x + " " + y + " " + type);
+      }
+
+      public static function added(bo:BasicObject) : void
+      {
+         var shot:Projectile = bo as Projectile;
+         if (shot != null && shot.props_ != null)
+         {
+            var size:Number = shot.projProps_ != null && shot.projProps_.size_ >= 0 ? shot.projProps_.size_ : 100;
+            var mine:int = map != null && map.player_ != null && shot.ownerId_ == map.player_.objectId_ ? 1 : 0;
+            send("j " + shot.objectId_ + " " + shot.props_.type_ + " " + fix(shot.x_) + " " + fix(shot.y_) + " " + int(size) + " " + mine);
+            seenShots[shot.objectId_] = fix(shot.x_) + " " + fix(shot.y_);
+            return;
+         }
+         var go:GameObject = bo as GameObject;
+         if (go == null || go.props_ == null || (map != null && go == map.player_))
+         {
+            return;
+         }
+         send("o " + go.objectId_ + " " + looks(go) + " " + fix(go.x_) + " " + fix(go.y_) + " " + go.size_
+              + " " + (go.props_.static_ ? 1 : 0) + health(go));
+         petSkins[go.objectId_] = looks(go);
+         if (go is RomtgPet && map != null && map.name_ != "Pet Yard")
+         {
+            log("a pet appeared in " + map.name_ + ": object " + go.objectId_ + " type 0x" + go.objectType_.toString(16));
+         }
+         if (!go.props_.static_)
+         {
+            seen[go.objectId_] = fix(go.x_) + " " + fix(go.y_) + health(go);
+         }
+      }
+
+      /** A status text appeared over someone; yours go to Doom (XP, level up, quest done...),
+       *  and the ones over others (the damage you do them, mostly) go over them in Doom. */
+      public static function status(text:CharacterStatusText) : void
+      {
+         if (map == null || text == null || text.go_ == null || text.label_ == null)
+         {
+            return;
+         }
+         if (text.go_ != map.player_)
+         {
+            if (viewing)
+            {
+               send("dmg " + text.go_.objectId_ + " " + text.color_.toString(16) + " " + oneLine(text.label_));
+            }
+            return;
+         }
+         send("st " + text.color_.toString(16) + " " + oneLine(text.label_));
+         HudWindow.status(text.label_, text.color_);
+      }
+
+      private static var tipShown:String = "";
+      private static var lastAttack:int = 0;
+      private static var panelLogged:Boolean = false;
+
+      /** Where `d` is in RotMG's window, in its 800x600 units, measured against the side panel
+       *  (HUDView), which is always units 600-800 across and 0-600 down. Not against the stage's
+       *  size: with Windows' display scaling the stage's size and its coordinates disagree (the
+       *  tooltip copy landed mid-screen at 2560x1440, 2026-11-12). */
+      public static function inRotmgUnits(d:DisplayObject) : Rectangle
+      {
+         if (d == null || d.stage == null || map == null || map.gs_ == null || map.gs_.hudView == null || map.gs_.hudView.stage == null)
+         {
+            return null;
+         }
+         var panel:Rectangle = map.gs_.hudView.getBounds(d.stage);
+         if (panel.width <= 0)
+         {
+            return null;
+         }
+         // TK's stage is the window's pixels with RotMG's 800x600 area centred in it: the window's
+         // corner is at stage (-(W-800)/2, -(H-600)/2). Ryan's log (2026-11-12): stage 1920x1440,
+         // side panel bounds x 875..1360, y -420..1020, which is exactly window x 1435..1920,
+         // y 0..1440 under that rule, and his recording's native tooltip lands where it says.
+         // (Every earlier guess missed the centring: mid-screen, then too high, too low, too big.)
+         var w:Number = d.stage.stageWidth, h:Number = d.stage.stageHeight;
+         var unit:Number = w / 800;                    // window pixels per RotMG unit (4:3: = h / 600)
+         var left:Number = -(w - 800) / 2;             // the window's left edge, on the stage
+         var top:Number = -(h - 600) / 2;              // and its top
+         if (!panelLogged)
+         {
+            panelLogged = true;
+            log("side panel on the stage: " + panel + ", stage " + d.stage.stageWidth + "x" + d.stage.stageHeight
+                + ", tooltip " + d.getBounds(d.stage));
+         }
+         var g:Rectangle = d.getBounds(d.stage);
+         return new Rectangle((g.x - left) / unit, (g.y - top) / unit, g.width / unit, g.height / unit);
+      }
+
+      /** A tooltip moved, or went (`showing` false): where it is, for the swapper to let it show
+       *  over Doom while you use RotMG's side panel. */
+      public static function tooltip(tip:Object, showing:Boolean) : void
+      {
+         var r:Rectangle = showing && tip != null && tip.stage != null ? inRotmgUnits(tip as DisplayObject) : null;
+         HudWindow.tooltip(tip as DisplayObject, showing && viewing && r != null, r);
+         var line:String = "tip -";
+         if (r != null)
+         {
+            line = "tip " + int(r.x) + " " + int(r.y) + " " + int(Math.ceil(r.width)) + " " + int(Math.ceil(r.height));
+         }
+         if (line != tipShown)
+         {
+            tipShown = line;
+            send(line);
+            flush();
+         }
+      }
+
+      private static var petSkins:Dictionary = new Dictionary();
+
+      /** The object type whose picture shows `go`: a pet's skin, or the object's own type. */
+      private static function looks(go:GameObject) : int
+      {
+         var pet:RomtgPet = go as RomtgPet;
+         return pet != null && pet.skinType > 0 ? pet.skinType : go.objectType_;
+      }
+
+      /** " HP MAX" for an enemy, "" for anything else. */
+      private static function health(go:GameObject) : String
+      {
+         return go.props_ != null && go.props_.isEnemy_ ? " " + go.hp_ + " " + go.maxHP_ : "";
+      }
+
+      public static function chat(name:String, to:String, text:String, nameColor:int, textColor:int) : void
+      {
+         send("chat " + uint(nameColor).toString(16) + " " + uint(textColor).toString(16) + " "
+              + oneLine(name) + "\t" + oneLine(to) + "\t" + oneLine(text));
+      }
+
+      public static function removed(objectId:int, bo:BasicObject) : void
+      {
+         if (bo is Projectile)
+         {
+            delete seenShots[objectId];
+            send("rj " + objectId);
+         }
+         else
+         {
+            delete seen[objectId];
+            send("r " + objectId);
+         }
+      }
+
+      /** Once a frame from your player: where you are, what moved, your weapon; then the
+       *  frame's lines go out. */
+      public static function position(player:Player, tilesPerSecond:Number) : void
+      {
+         var now:int = getTimer();
+         if ((player.x_ != lastX || player.y_ != lastY) && now - posAt >= POS_MS)
+         {
+            posAt = now;
+            lastX = player.x_;
+            lastY = player.y_;
+            send("p " + player.x_.toFixed(4) + " " + player.y_.toFixed(4) + " " + tilesPerSecond.toFixed(4));
+         }
+         // You are the camera in Doom: the bridge must never draw you as an object (your own
+         // object can be reported before map.player_ is set).
+         if (player.objectId_ != me)
+         {
+            me = player.objectId_;
+            send("me " + me);
+         }
+         var held:int = player.equipment_ != null && player.equipment_.length > 0 ? player.equipment_[0] : -1;
+         if (held != weapon)
+         {
+            weapon = held;
+            send("w " + held);
+         }
+         if (map != null && now - hudAt >= HUD_MS)
+         {
+            hudAt = now;
+            hud(player, now);
+         }
+         if (viewing)
+         {
+            hideOwnHud(true);
+            HudWindow.update(map, player, now);
+         }
+         // A shot (or swing) just went: Doom animates the weapon in your hand over the time
+         // to the next one, your weapon's real rate of fire (Player.attackPeriod_, ms).
+         if (player.attackStart_ != lastAttack)
+         {
+            lastAttack = player.attackStart_;
+            send("atk " + int(Math.max(80, player.attackPeriod_)));
+         }
+         if (map != null && now - objectsAt >= OBJECTS_MS)
+         {
+            objectsAt = now;
+            var go:GameObject;
+            for each (go in map.goDict_)
+            {
+               if (go.props_ == null || go.props_.static_ || go == player)
+               {
+                  continue;
+               }
+               // A pet's look comes after it appears (its skin stat): show it again with it.
+               if (go is RomtgPet && petSkins[go.objectId_] != looks(go))
+               {
+                  added(go);
+                  continue;
+               }
+               var at:String = fix(go.x_) + " " + fix(go.y_) + health(go);
+               if (seen[go.objectId_] != at)
+               {
+                  seen[go.objectId_] = at;
+                  send("u " + go.objectId_ + " " + at);
+               }
+            }
+         }
+         if (map != null && now - projectilesAt >= PROJECTILES_MS)
+         {
+            projectilesAt = now;
+            var bo:BasicObject;
+            for each (bo in map.boDict_)
+            {
+               var shot:Projectile = bo as Projectile;
+               if (shot == null)
+               {
+                  continue;
+               }
+               var where:String = fix(shot.x_) + " " + fix(shot.y_);
+               if (seenShots[shot.objectId_] != where)
+               {
+                  seenShots[shot.objectId_] = where;
+                  send("uj " + shot.objectId_ + " " + where);
+               }
+            }
+         }
+         flush();
+      }
+
+      /** The quest (boss) and your gold and fame, when they change. */
+      private static function hud(player:Player, now:int) : void
+      {
+         var quest:String = "quest -1";
+         var q:GameObject = map.quest_ != null ? map.quest_.getObject(now) : null;
+         if (q != null && q.props_ != null)
+         {
+            var name:String = q.props_.displayId_ != null && q.props_.displayId_ != "" ? q.props_.displayId_ : q.props_.id_;
+            quest = "quest " + q.objectId_ + " " + fix(q.x_) + " " + fix(q.y_) + " " + q.hp_ + " " + q.maxHP_ + " " + oneLine(name);
+         }
+         if (quest != lastQuest)
+         {
+            lastQuest = quest;
+            send(quest);
+         }
+         var cash:String = "cash " + player.credits_ + " " + player.fame_;
+         if (cash != lastCash)
+         {
+            lastCash = cash;
+            send(cash);
+         }
+      }
+
+      /** RotMG's own HUD over the play area, hidden while Doom shows it (or back). */
+      private static function hideOwnHud(hide:Boolean) : void
+      {
+         if (map == null || map.gs_ == null)
+         {
+            return;
+         }
+         if (map.gs_.textBox_ != null) map.gs_.textBox_.visible = !hide;
+         if (map.gs_.creditDisplay_ != null) map.gs_.creditDisplay_.visible = !hide;
+         if (map.mapOverlay_ != null) map.mapOverlay_.visible = !hide;
+         if (map.partyOverlay_ != null) map.partyOverlay_.visible = !hide;
+         if (map.gs_.bossHealthBar != null)
+         {
+            map.gs_.bossHealthBar.visible = !hide;
+            if (!hide)
+            {
+               map.gs_.bossHealthBar.draw();   // hides itself again if there's no boss
+            }
+         }
+      }
+
+      /** While Doom has the controls and you hold fire: shoot where Doom aims. Your weapon's own
+       *  rate of fire applies, as with the mouse. */
+      public static function shoot(player:Player) : void
+      {
+         if (controlling && firing)
+         {
+            player.attemptAttackAngle(aim - Parameters.data_.cameraAngle);
+         }
+      }
+
+      private static var logged:int = 0;
+
+      /** A line for the bridge's log (logs/bridge.log), to see afterwards what the client did.
+       *  At most 300 a run. */
+      public static function log(text:String) : void
+      {
+         if (logged < 300)
+         {
+            logged++;
+            send("log " + oneLine(text));
+         }
+      }
+
+      public static function send(line:String) : void
+      {
+         connect();
+         if (socket != null && socket.connected)
+         {
+            socket.writeUTFBytes(line + "\n");
+         }
+      }
+
+      public static function flush() : void
+      {
+         connect();
+         if (socket != null && socket.connected)
+         {
+            try
+            {
+               socket.flush();
+            }
+            catch (e:Error)
+            {
+               drop();
+            }
+         }
+      }
+
+      private static function connect() : void
+      {
+         if (socket != null || getTimer() < retryAt)
+         {
+            return;
+         }
+         retryAt = getTimer() + RETRY_MS;
+         socket = new Socket();
+         socket.addEventListener(Event.CONNECT, onConnect);
+         socket.addEventListener(Event.CLOSE, onClose);
+         socket.addEventListener(IOErrorEvent.IO_ERROR, onClose);
+         socket.addEventListener(SecurityErrorEvent.SECURITY_ERROR, onClose);
+         socket.addEventListener(ProgressEvent.SOCKET_DATA, onData);
+         try
+         {
+            socket.connect("127.0.0.1", PORT);
+         }
+         catch (e:Error)
+         {
+            drop();
+         }
+      }
+
+      /** The swapper just came up: it gets the whole map as it is now. */
+      private static function onConnect(event:Event) : void
+      {
+         if (map == null)
+         {
+            return;
+         }
+         send("map " + clean(map.name_) + " " + map.width_ + " " + map.height_);
+         var square:Square;
+         for each (square in map.squares_)
+         {
+            if (square != null && square.tileType_ != 255)
+            {
+               tile(square.x_, square.y_, square.tileType_);
+            }
+         }
+         seen = new Dictionary();
+         seenShots = new Dictionary();
+         var go:GameObject;
+         for each (go in map.goDict_)
+         {
+            added(go);
+         }
+         var bo:BasicObject;
+         for each (bo in map.boDict_)
+         {
+            added(bo);
+         }
+         lastX = NaN;
+         weapon = -2;
+         me = -1;
+         lastQuest = lastCash = "";
+         flush();
+      }
+
+      private static function onData(event:ProgressEvent) : void
+      {
+         incoming += socket.readUTFBytes(socket.bytesAvailable);
+         var end:int = incoming.indexOf("\n");
+         while (end >= 0)
+         {
+            handle(incoming.substring(0, end));
+            incoming = incoming.substring(end + 1);
+            end = incoming.indexOf("\n");
+         }
+      }
+
+      private static function handle(line:String) : void
+      {
+         var parts:Array = line.split(" ");
+         if (parts[0] == "ctl")
+         {
+            controlling = parts[1] == "1";
+            if (controlling)
+            {
+               HudWindow.tooltip(null, false);   // back in Doom: no tooltip left hanging over it
+            }
+            moveX = moveY = 0;
+            firing = false;
+         }
+         else if (parts[0] == "m" && parts.length >= 3)
+         {
+            moveX = Number(parts[1]);
+            moveY = Number(parts[2]);
+            if (isNaN(moveX) || isNaN(moveY))
+            {
+               moveX = moveY = 0;
+            }
+         }
+         else if (parts[0] == "fire")
+         {
+            if (parts.length >= 3 && !isNaN(Number(parts[2])))
+            {
+               aim = Number(parts[2]);
+            }
+            firing = parts[1] == "1";
+         }
+         else if (parts[0] == "view")
+         {
+            var was:Boolean = viewing;
+            viewing = parts[1] == "1";
+            if (was && !viewing)
+            {
+               hideOwnHud(false);
+               HudWindow.hide();
+            }
+            else if (viewing && !was)
+            {
+               HudWindow.show();
+            }
+         }
+         else if (parts[0] == "act" && parts.length >= 2 && controlling)
+         {
+            act(String(parts[1]));
+         }
+      }
+
+      /** RotMG's own key for NAME, as if pressed: potions, nexus, inventory slots, interact
+       *  (portals)... all go through the player's own bindings and the client's own checks.
+       *  The ability aims where Doom looks. */
+      private static function act(name:String) : void
+      {
+         // "NAME:down" / "NAME:up": a key held in Doom (Q/E turning the camera), pressed and
+         // released as you do.
+         var half:String = null;
+         if (name.indexOf(":") > 0)
+         {
+            half = name.substr(name.indexOf(":") + 1);
+            name = name.substr(0, name.indexOf(":"));
+         }
+         var player:Player = map != null ? map.player_ : null;
+         if (player == null)
+         {
+            return;
+         }
+         if (name == "useSpecial")
+         {
+            var screen:Number = aim - Parameters.data_.cameraAngle;
+            var xS:Number = Math.cos(screen) * ABILITY_REACH;
+            var yS:Number = Math.sin(screen) * ABILITY_REACH;
+            player.useAltWeapon(xS, yS, UseType.START_USE);
+            player.useAltWeapon(xS, yS, UseType.END_USE);
+            return;
+         }
+         if (!Parameters.data_.hasOwnProperty(name) || !(Parameters.data_[name] is int || Parameters.data_[name] is uint))
+         {
+            return;
+         }
+         var code:uint = Parameters.data_[name];
+         if (map.gs_ == null || map.gs_.stage == null)
+         {
+            return;
+         }
+         if (half != "up")
+         {
+            map.gs_.stage.dispatchEvent(new KeyboardEvent(KeyboardEvent.KEY_DOWN, true, false, 0, code));
+         }
+         if (half != "down")
+         {
+            map.gs_.stage.dispatchEvent(new KeyboardEvent(KeyboardEvent.KEY_UP, true, false, 0, code));
+         }
+      }
+
+      private static function onClose(event:Event) : void
+      {
+         drop();
+      }
+
+      private static function drop() : void
+      {
+         if (viewing)
+         {
+            viewing = false;
+            hideOwnHud(false);
+            HudWindow.hide();
+         }
+         controlling = false;
+         firing = false;
+         moveX = moveY = 0;
+         if (socket == null)
+         {
+            return;
+         }
+         socket.removeEventListener(Event.CONNECT, onConnect);
+         socket.removeEventListener(Event.CLOSE, onClose);
+         socket.removeEventListener(IOErrorEvent.IO_ERROR, onClose);
+         socket.removeEventListener(SecurityErrorEvent.SECURITY_ERROR, onClose);
+         socket.removeEventListener(ProgressEvent.SOCKET_DATA, onData);
+         try
+         {
+            if (socket.connected)
+            {
+               socket.close();
+            }
+         }
+         catch (e:Error)
+         {
+         }
+         socket = null;
+         incoming = "";
+      }
+
+      private static function oneLine(text:String) : String
+      {
+         return text == null ? "" : text.split("\n").join(" ").split("\r").join(" ").split("\t").join(" ");
+      }
+
+      private static function fix(n:Number) : String
+      {
+         return n.toFixed(3);
+      }
+
+      private static function clean(name:String) : String
+      {
+         return name == null || name == "" ? "?" : name.split(" ").join("_");
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/HudWindow.as b/TK-Client/src/romtg/HudWindow.as
new file mode 100644
index 0000000..6278d4a
--- /dev/null
+++ b/TK-Client/src/romtg/HudWindow.as
@@ -0,0 +1,398 @@
+package romtg
+{
+   import com.company.assembleegameclient.map.Map;
+   import com.company.assembleegameclient.objects.Character;
+   import com.company.assembleegameclient.objects.GameObject;
+   import com.company.assembleegameclient.objects.Player;
+   import com.company.assembleegameclient.ui.TextBox;
+   import com.company.assembleegameclient.ui.TextBoxLine;
+   import com.company.assembleegameclient.util.TextureRedrawer;
+   import com.company.ui.SimpleText;
+   import com.company.util.AssetLibrary;
+   import flash.display.Bitmap;
+   import flash.display.BitmapData;
+   import flash.display.DisplayObject;
+   import flash.display.NativeWindow;
+   import flash.display.NativeWindowInitOptions;
+   import flash.display.NativeWindowSystemChrome;
+   import flash.display.NativeWindowType;
+   import flash.display.Sprite;
+   import flash.display.StageAlign;
+   import flash.display.StageScaleMode;
+   import flash.filters.DropShadowFilter;
+   import flash.filters.GlowFilter;
+   import flash.geom.Matrix;
+   import flash.geom.Rectangle;
+   import flash.text.engine.TextBlock;
+   import flash.text.engine.TextLine;
+   import flash.utils.getTimer;
+   import kabam.rotmg.ui.view.BossHealthBar;
+
+   /**
+    * ROMTG-Doom: RotMG's own HUD over Doom. A see-through, click-through window (the swapper,
+    * duo.py, finds it by its title and lays it over Doom) holding fresh copies of RotMG's gold
+    * and fame display, boss health bar, chat lines and the status texts over you (XP, level up,
+    * quest done...), drawn by RotMG's own classes so they look exactly as in RotMG. Scaled like
+    * RotMG's own window (its 600-high stage fills the screen's height). While it is up, the
+    * originals in RotMG's play area are hidden (DoomLink.hideOwnHud), so the minimap stays clean.
+    */
+   public class HudWindow
+   {
+      // (logs: DoomLink.log)
+      public static const TITLE:String = "RomtgHud";
+      private static const CHAT_LINES:int = 7;
+      private static const CHAT_MS:int = 20000;
+      /** Chat lines wrap at this width, so they stay clear of your health bar (bottom middle). */
+      private static const CHAT_WIDTH:int = 340;
+      private static const STATUS_MS:int = 1500;
+      /** Where the status texts start (just above your health bar, whose top is at 554), how
+       *  far up they go in their 1.5 s (fading out over the second half) and how far apart ones
+       *  that came together are. */
+      private static const STATUS_FROM:Number = 526;
+      private static const STATUS_RISE:Number = 60;
+      private static const STATUS_GAP:Number = 24;
+
+      private static var window:NativeWindow;
+      private static var root:Sprite;
+      private static var credits:Sprite;
+      private static var coinText:SimpleText;
+      private static var fameText:SimpleText;
+      private static var shownCredits:String = "";
+      /** A copy of the RotMG tooltip you're looking at (Tab, the side panel's inventory), drawn
+       *  here so it shows over Doom; RotMG's own window stays cut down to its side panel. */
+      private static var tipCopy:Bitmap;
+      private static var tipFrom:DisplayObject;
+      private static var tipDrawnAt:int = 0;
+      private static var tipSize:String = "";
+      /** This window's width in RotMG's units (it's 600 high): RotMG's play area (0..600 of its
+       *  stage) ends where this window ends, so a RotMG x is this one's x + (hudWidth - 600). */
+      private static var hudWidth:Number = 600;
+      private static var boss:BossHealthBar;
+      private static var chat:Sprite;
+      private static var statuses:Sprite;
+      private static var shownChat:int = -1;
+      private static var chatAt:int = 0;
+      private static var statusList:Array = [];
+      private static var myHealth:Sprite;
+      private static var myHealthText:SimpleText;
+      private static var shownHealth:String = "";
+      private static var chatShown:String = "";
+      /** Your health bar: RotMG's bar under a character (42x7 back, 40x5 fill), this many times
+       *  bigger, at the bottom middle of the screen, where your character would stand. */
+      private static const MY_BAR:Number = 4;
+
+      public static function show() : void
+      {
+         if (window != null && !window.closed)
+         {
+            window.visible = true;
+            return;
+         }
+         var options:NativeWindowInitOptions = new NativeWindowInitOptions();
+         options.systemChrome = NativeWindowSystemChrome.NONE;
+         options.transparent = true;
+         options.type = NativeWindowType.LIGHTWEIGHT;
+         window = new NativeWindow(options);
+         window.title = TITLE;
+         window.stage.scaleMode = StageScaleMode.NO_SCALE;
+         window.stage.align = StageAlign.TOP_LEFT;
+         window.width = 800;
+         window.height = 600;
+         root = new Sprite();
+         root.mouseEnabled = root.mouseChildren = false;
+         window.stage.addChild(root);
+         credits = makeCredits();
+         root.addChild(credits);
+         boss = new BossHealthBar();
+         boss.visible = false;
+         root.addChild(boss);
+         chat = new Sprite();
+         chat.filters = [new GlowFilter(0, 1, 3, 3, 2, 1)];
+         root.addChild(chat);
+         statuses = new Sprite();
+         root.addChild(statuses);
+         myHealth = new Sprite();
+         root.addChild(myHealth);
+         myHealthText = new SimpleText(14, 0xFFFFFF, false, 0, 0);
+         myHealthText.setBold(true);
+         myHealthText.filters = [new GlowFilter(0, 1, 3, 3, 2, 1)];
+         root.addChild(myHealthText);
+         tipCopy = new Bitmap();
+         tipCopy.visible = false;
+         root.addChild(tipCopy);   // last: over everything else
+         tipFrom = null;
+         shownCredits = "";
+         shownHealth = "";
+         chatShown = "";
+         shownChat = -1;
+         window.visible = true;   // shown, not activated: the swapper keeps it from taking focus
+      }
+
+      public static function hide() : void
+      {
+         if (window != null && !window.closed)
+         {
+            window.visible = false;
+         }
+         statusList = [];
+         if (statuses != null)
+         {
+            statuses.removeChildren();
+         }
+         tooltip(null, false);
+      }
+
+      /** Gold and fame as RotMG shows them (its coin and fame icons with the numbers to their
+       *  left), made here with icons of its own: CreditDisplay's shared, cached ones didn't show
+       *  in this window (2026-11-12). */
+      private static function makeCredits() : Sprite
+      {
+         var s:Sprite = new Sprite();
+         var coin:Bitmap = new Bitmap(TextureRedrawer.redraw(AssetLibrary.getImageFromSet("lofiObj3", 225), 40, true, 0, false));
+         var fame:Bitmap = new Bitmap(TextureRedrawer.redraw(AssetLibrary.getImageFromSet("lofiObj3", 224), 40, true, 0, false));
+         coin.name = "coin";
+         fame.name = "fame";
+         s.addChild(coin);
+         s.addChild(fame);
+         coinText = new SimpleText(18, 0xFFFFFF, false, 0, 0);
+         coinText.filters = [new DropShadowFilter(0, 0, 0, 1, 4, 4, 2)];
+         fameText = new SimpleText(18, 0xFFFFFF, false, 0, 0);
+         fameText.filters = [new DropShadowFilter(0, 0, 0, 1, 4, 4, 2)];
+         s.addChild(coinText);
+         s.addChild(fameText);
+         return s;
+      }
+
+      private static function drawCredits(gold:int, fame:int) : void
+      {
+         var key:String = gold + "/" + fame;
+         if (key == shownCredits)
+         {
+            return;
+         }
+         shownCredits = key;
+         var coin:DisplayObject = credits.getChildByName("coin");
+         var icon:DisplayObject = credits.getChildByName("fame");
+         coin.x = -coin.width;
+         coin.y = 0;
+         coinText.text = gold.toString();
+         coinText.updateMetrics();
+         coinText.x = coin.x - coinText.width + 8;
+         coinText.y = coin.height / 2 - coinText.height / 2;
+         icon.x = -icon.width;
+         fameText.text = fame.toString();
+         fameText.updateMetrics();
+         fameText.x = icon.x - fameText.width + 8;
+         fameText.y = coinText.height + 4 + icon.height / 2 - fameText.height / 2;
+         icon.y = fameText.y - icon.height / 2 + 8;
+      }
+
+      /** RotMG's tooltip `tip` moved or changed (or went, `showing` false): copied over here. */
+      public static function tooltip(tip:DisplayObject, showing:Boolean, at:Rectangle = null) : void
+      {
+         if (tipCopy == null)
+         {
+            return;
+         }
+         if (!showing || at == null || tip == null || tip.stage == null || window == null || window.closed || !window.visible)
+         {
+            if (tip == null || tip == tipFrom)
+            {
+               tipCopy.visible = false;
+               tipFrom = null;
+            }
+            return;
+         }
+         var b:Rectangle = tip.getBounds(tip);
+         var size:String = int(b.width) + "x" + int(b.height);
+         var now:int = getTimer();
+         if (tip != tipFrom || size != tipSize || now - tipDrawnAt > 250)
+         {
+            if (b.width < 1 || b.height < 1)
+            {
+               return;
+            }
+            var bd:BitmapData = new BitmapData(Math.ceil(b.width), Math.ceil(b.height), true, 0);
+            bd.draw(tip, new Matrix(1, 0, 0, 1, -b.x, -b.y));
+            if (tipCopy.bitmapData != null)
+            {
+               tipCopy.bitmapData.dispose();
+            }
+            tipCopy.bitmapData = bd;
+            tipCopy.filters = tip.filters;
+            tipFrom = tip;
+            tipSize = size;
+            tipDrawnAt = now;
+         }
+         // `at`: where RotMG shows it, in its 800x600 units (DoomLink.inRotmgUnits).
+         tipCopy.scaleX = b.width > 0 ? at.width / b.width : 1;
+         tipCopy.scaleY = b.height > 0 ? at.height / b.height : 1;
+         tipCopy.x = at.x + (hudWidth - 600);
+         tipCopy.y = at.y;
+         if (!tipCopy.visible && tipsLogged < 8)
+         {
+            tipsLogged++;
+            DoomLink.log("tooltip copy at " + int(tipCopy.x) + "," + int(tipCopy.y) + " size " + size
+               + " in a HUD " + int(hudWidth) + " wide (scale " + root.scaleX.toFixed(2) + "), window "
+               + window.bounds + (window.visible ? " shown" : " HIDDEN"));
+         }
+         tipCopy.visible = true;
+      }
+
+      private static var tipsLogged:int = 0;
+
+      /** A status text over you in RotMG: the same words, colour and look, rising and fading. */
+      public static function status(label:String, color:uint) : void
+      {
+         if (window == null || window.closed || !window.visible)
+         {
+            return;
+         }
+         var t:SimpleText = new SimpleText(20, color, false, 0, 0);
+         t.setBold(true);
+         t.text = label;
+         t.updateMetrics();
+         t.filters = [new GlowFilter(0, 1, 4, 4, 2, 1)];
+         t.x = -t.width / 2;   // centred over your health bar
+         var holder:Sprite = new Sprite();
+         holder.addChild(t);
+         statuses.addChild(holder);
+         statusList.push({sprite: holder, at: getTimer()});
+      }
+
+      /** Once a frame while Doom is up. */
+      public static function update(map:Map, player:Player, now:int) : void
+      {
+         if (window == null || window.closed || !window.visible || root == null)
+         {
+            return;
+         }
+         var sw:Number = window.stage.stageWidth, sh:Number = window.stage.stageHeight;
+         if (sw <= 0 || sh <= 0)
+         {
+            return;
+         }
+         var k:Number = sh / 600;
+         root.scaleX = root.scaleY = k;
+         var w:Number = sw / k;   // the window's width in RotMG's own units
+         hudWidth = w;
+
+         // Gold and fame: top right, as RotMG has them next to its side panel.
+         credits.x = w - 6;
+         credits.y = 0;
+         drawCredits(player.credits_, player.fame_);
+
+         // The boss bar: RotMG's quest, top left.
+         var quest:GameObject = map.quest_ != null ? map.quest_.getObject(now) : null;
+         boss.x = 10;
+         boss.y = 10;
+         boss.setGameObject(quest);
+         if (quest != null)
+         {
+            boss.visible = true;
+         }
+         boss.draw();
+
+         // Chat: RotMG's lines, bottom left, gone after 20 seconds as in RotMG.
+         drawChat(now, 600);
+
+         // Your own health, as RotMG shows it under your character: bottom middle.
+         drawMyHealth(player, w);
+
+         // Status texts over you (+EXP, healing...): just above your health bar at the bottom,
+         // where RotMG shows them over your character, rising and fading. Ones that came
+         // together stack upwards.
+         for (var i:int = statusList.length - 1; i >= 0; i--)
+         {
+            if (now - statusList[i].at >= STATUS_MS)
+            {
+               statuses.removeChild(statusList[i].sprite);
+               statusList.splice(i, 1);
+            }
+         }
+         var below:Number = 1e9;
+         for (i = statusList.length - 1; i >= 0; i--)
+         {
+            var s:Object = statusList[i];
+            var age:Number = (now - s.at) / STATUS_MS;
+            var sy:Number = Math.min(STATUS_FROM - age * STATUS_RISE, below - STATUS_GAP);
+            below = sy;
+            s.sprite.x = w / 2;
+            s.sprite.y = sy;
+            s.sprite.alpha = age < 0.5 ? 1 : Math.max(0, (1 - age) / 0.5);
+         }
+      }
+
+      private static function drawMyHealth(player:Player, w:Number) : void
+      {
+         var key:String = player.hp_ + "/" + player.maxHP_ + "@" + int(w);
+         if (key == shownHealth)
+         {
+            return;
+         }
+         shownHealth = key;
+         var g:* = myHealth.graphics;
+         g.clear();
+         var bw:Number = 40 * MY_BAR, bh:Number = 5 * MY_BAR, x:Number = w / 2 - bw / 2, y:Number = 600 - 46;
+         // The empty part dark and see-through, and only a hairline (one screen pixel) round it.
+         g.beginFill(0x111111, 0.55);
+         g.drawRect(x, y, bw, bh);
+         g.endFill();
+         var frac:Number = player.maxHP_ > 0 ? Math.max(0, Math.min(1, player.hp_ / player.maxHP_)) : 0;
+         if (frac > 0)
+         {
+            g.beginFill(Character.green2redu(uint(frac * 100)));
+            g.drawRect(x, y, bw * frac, bh);
+            g.endFill();
+         }
+         g.lineStyle(0, 0x000000, 0.8);
+         g.drawRect(x, y, bw, bh);
+         g.lineStyle();
+         myHealthText.text = player.hp_ + "/" + player.maxHP_;
+         myHealthText.updateMetrics();
+         myHealthText.x = w / 2 - myHealthText.width / 2;
+         myHealthText.y = y + bh / 2 - myHealthText.height / 2;
+      }
+
+      private static function drawChat(now:int, h:Number) : void
+      {
+         // Redrawn only when what it shows changes (a line came, or one timed out): redrawing it
+         // every second made it flicker.
+         var lines:Vector.<TextBoxLine> = TextBox.allLines;
+         var first:int = Math.max(0, lines.length - CHAT_LINES);
+         var shows:String = lines.length + ":";
+         for (var j:int = first; j < lines.length; j++)
+         {
+            shows += now > lines[j].time_ + CHAT_MS ? "0" : "1";
+         }
+         if (shows == chatShown)
+         {
+            return;
+         }
+         chatShown = shows;
+         chat.removeChildren();
+         var y:Number = 0;
+         for (var i:int = first; i < lines.length; i++)
+         {
+            var line:TextBoxLine = lines[i];
+            if (now > line.time_ + CHAT_MS)
+            {
+               continue;
+            }
+            var block:TextBlock = line.getTextBlock();
+            var text:TextLine = null;
+            var top:Number = y;
+            while ((text = block.createTextLine(text, y == top ? CHAT_WIDTH - 4 : CHAT_WIDTH - 24)) != null)
+            {
+               text.x = y == top ? 0 : 20;
+               text.y = text.ascent + y;
+               y += Math.max(16, text.height);
+               chat.addChild(text);
+            }
+            y += 4;
+         }
+         chat.x = 2;
+         chat.y = h - y + 4;   // flush with the bottom-left corner, as RotMG has it
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/RealmArt.as b/TK-Client/src/romtg/RealmArt.as
new file mode 100644
index 0000000..0429aa2
--- /dev/null
+++ b/TK-Client/src/romtg/RealmArt.as
@@ -0,0 +1,87 @@
+package romtg
+{
+   import flash.display.Bitmap;
+   import flash.display.DisplayObject;
+   import flash.display.Loader;
+   import flash.display.Sprite;
+   import flash.events.Event;
+   import flash.events.IOErrorEvent;
+   import flash.net.URLRequest;
+
+   /**
+    * ROMTG-Doom: Realm of the Mad God's own title art, taken from your Exalt install when the
+    * client is built (rotmg-doom/scripts/exalt.py -> assets/realm-*.png next to the client; never
+    * part of this repo) and loaded here at run time. Without it: the name as text (RealmTitle).
+    */
+   public class RealmArt
+   {
+      /** The logo, centred on (cx, top), at most `width` wide. */
+      public static function logo(cx:Number, top:Number, width:Number) : Sprite
+      {
+         var holder:Sprite = new Sprite();
+         holder.mouseEnabled = holder.mouseChildren = false;
+         load("app:/assets/realm-logo.png", holder, function(art:DisplayObject):void
+         {
+            art.width = width;
+            art.scaleY = art.scaleX;
+            art.x = cx - art.width / 2;
+            art.y = top;
+         }, function():void
+         {
+            var title:RealmTitle = new RealmTitle();
+            title.x = cx;
+            title.y = top + 30;
+            holder.addChild(title);
+         });
+         return holder;
+      }
+
+      /** The title background, covering the 800x600 stage (cropped to keep its shape). */
+      public static function background() : Sprite
+      {
+         var holder:Sprite = new Sprite();
+         holder.mouseEnabled = holder.mouseChildren = false;
+         load("app:/assets/realm-title-bg.png", holder, function(art:DisplayObject):void
+         {
+            var k:Number = Math.max(800 / art.width, 600 / art.height);
+            art.scaleX = art.scaleY = k;
+            art.x = (800 - art.width) / 2;
+            art.y = (600 - art.height) / 2;
+         }, null);
+         return holder;
+      }
+
+      private static function load(url:String, holder:Sprite, place:Function, fallback:Function) : void
+      {
+         var loader:Loader = new Loader();
+         loader.contentLoaderInfo.addEventListener(Event.COMPLETE, function(e:Event):void
+         {
+            var art:DisplayObject = loader.content;
+            if (art is Bitmap)
+            {
+               (art as Bitmap).smoothing = true;
+            }
+            place(art);
+            holder.addChild(art);
+         });
+         loader.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR, function(e:Event):void
+         {
+            if (fallback != null)
+            {
+               fallback();
+            }
+         });
+         try
+         {
+            loader.load(new URLRequest(url));
+         }
+         catch (e:Error)
+         {
+            if (fallback != null)
+            {
+               fallback();
+            }
+         }
+      }
+   }
+}
diff --git a/TK-Client/src/romtg/RealmTitle.as b/TK-Client/src/romtg/RealmTitle.as
new file mode 100644
index 0000000..f7d7a59
--- /dev/null
+++ b/TK-Client/src/romtg/RealmTitle.as
@@ -0,0 +1,37 @@
+package romtg
+{
+   import com.company.ui.SimpleText;
+   import flash.display.Sprite;
+   import flash.filters.DropShadowFilter;
+   import flash.filters.GlowFilter;
+
+   /**
+    * ROMTG-Doom: the game's name on the title screen, in the client's own font, where Talisman
+    * Kingdom's logo was. (Realm of the Mad God's logo image isn't among the client's files.)
+    */
+   public class RealmTitle extends Sprite
+   {
+      public function RealmTitle()
+      {
+         super();
+         var top:SimpleText = line("Realm of the", 34);
+         var bottom:SimpleText = line("Mad God", 64);
+         top.x = -top.width / 2;
+         bottom.x = -bottom.width / 2;
+         bottom.y = top.height - 10;
+         addChild(top);
+         addChild(bottom);
+         mouseEnabled = mouseChildren = false;
+      }
+
+      private static function line(text:String, size:int) : SimpleText
+      {
+         var t:SimpleText = new SimpleText(size, 0xF2C14E, false, 0, 0);
+         t.setBold(true);
+         t.text = text;
+         t.updateMetrics();
+         t.filters = [new GlowFilter(0x5A1408, 1, 6, 6, 8, 1), new DropShadowFilter(4, 45, 0, 0.8, 6, 6, 1)];
+         return t;
+      }
+   }
+}
