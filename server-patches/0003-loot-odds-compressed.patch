+        /// <summary>ROMTG-Doom: the power every drop chance is raised to (ROMTGDOOM_LOOT_POWER, default 0.7).
+        /// Below 1 it compresses the odds: rare drops gain a lot, common ones a little, and their
+        /// order stays (8%/4%/2%/1% become 17%/10.5%/6.5%/4% at 0.7). 1 is the stock game.</summary>
+        public static readonly double LootPower =
+            double.TryParse(Environment.GetEnvironmentVariable("ROMTGDOOM_LOOT_POWER"), System.Globalization.NumberStyles.Float,
+                System.Globalization.CultureInfo.InvariantCulture, out var k) && k > 0 && k <= 1 ? k : 0.7;
+
+        /// <summary>ROMTG-Doom: a drop chance with the odds compressed (see LootPower).</summary>
+        public static double Compress(double probability) =>
+            probability <= 0 || probability >= 1 ? probability : Math.Pow(probability, LootPower);
+
+        /// <summary>ROMTG-Doom pets: RotMG's egg drops (RealmEye wiki, Pet Eggs and Loot
+        /// Containers, read 2026-11-12): eggs drop in an "egg basket" from realm gods, event
+        /// bosses and dungeon bosses only. Gods drop common and uncommon eggs; event and dungeon
+        /// bosses drop all four rarities; legendary eggs are the rarest drop in the game ("rarer
+        /// than event white bags"). Deca never published the rates and no server code with them
+        /// is public, so these stock chances are estimates kept in that order; each then goes
+        /// through Compress like every other drop. Before / after compression (0.7):
+        ///   god:  common 2% (6.5%), uncommon 0.5% (2.4%)
+        ///   boss: common 5% (12.3%), uncommon 2% (6.5%), rare 0.5% (2.4%), legendary 0.05% (0.5%)</summary>
+        private static readonly (PRarity Rarity, double God, double Boss)[] EggChances =
+        {
+            (PRarity.Common, 0.02, 0.05),
+            (PRarity.Uncommon, 0.005, 0.02),
+            (PRarity.Rare, 0, 0.005),
+            (PRarity.Legendary, 0, 0.0005),
+        };
+
+        /// <summary>An egg of RARITY, of a random family; null if there's none.</summary>
+        private static string RandomPetEgg(XmlData gameData, PRarity rarity)
+        {
+            var eggs = gameData.Items.Values.Where(i => i.Rarity == rarity &&
+                i.ActivateEffects.Any(a => a.Effect == ActivateEffects.CreatePet)).ToArray();
+            return eggs.Length == 0 ? null : eggs[Random.Shared.Next(eggs.Length)].ObjectId;
+        }
