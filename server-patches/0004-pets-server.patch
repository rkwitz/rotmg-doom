diff --git a/TK-Server/TKR.WorldServer/networking/packets/outgoing/pets/PetMessages.cs b/TK-Server/TKR.WorldServer/networking/packets/outgoing/pets/PetMessages.cs
new file mode 100644
index 0000000..0d6616e
--- /dev/null
+++ b/TK-Server/TKR.WorldServer/networking/packets/outgoing/pets/PetMessages.cs
@@ -0,0 +1,80 @@
+using TKR.Shared;
+using TKR.Shared.resources;
+
+// ROMTG-Doom: RotMG's pet messages to the client, ported from NR-CORE (AGPL-3.0). Same fields
+// and order as the NR 27.7 client reads them; the numbers are TKR's (MessageId).
+namespace TKR.WorldServer.networking.packets.outgoing.pets
+{
+    /// <summary>An egg hatched: the new pet's name and skin, for the hatch dialog.</summary>
+    public class HatchPet : OutgoingMessage
+    {
+        public string PetName { get; set; }
+        public int PetSkin { get; set; }
+        public int ItemType { get; set; }   // not sent: NR's client doesn't read it
+
+        public override MessageId MessageId => MessageId.HATCH_PET;
+
+        public override void Write(NetworkWriter wtr)
+        {
+            wtr.WriteUTF16(PetName ?? "");
+            wtr.Write(PetSkin);
+        }
+    }
+
+    /// <summary>Your active pet (the one that follows you); -1 for none.</summary>
+    public class ActivePetUpdate : OutgoingMessage
+    {
+        public int InstanceId { get; set; }
+
+        public override MessageId MessageId => MessageId.ACTIVE_PET_UPDATE;
+
+        public override void Write(NetworkWriter wtr) => wtr.Write(InstanceId);
+    }
+
+    /// <summary>Fusing unlocked a pet's next ability.</summary>
+    public class NewAbility : OutgoingMessage
+    {
+        public PAbility Type { get; set; }
+
+        public override MessageId MessageId => MessageId.NEW_ABILITY;
+
+        public override void Write(NetworkWriter wtr) => wtr.Write((int)Type);
+    }
+
+    /// <summary>Your pet yard's new size.</summary>
+    public class PetYardUpdate : OutgoingMessage
+    {
+        public int Type { get; set; }
+
+        public override MessageId MessageId => MessageId.PET_YARD_UPDATE;
+
+        public override void Write(NetworkWriter wtr) => wtr.Write(Type);
+    }
+
+    /// <summary>A fusion evolved a pet into a new kind.</summary>
+    public class EvolvePet : OutgoingMessage
+    {
+        public int PetId { get; set; }
+        public int InitialSkin { get; set; }
+        public int FinalSkin { get; set; }
+
+        public override MessageId MessageId => MessageId.EVOLVE_PET;
+
+        public override void Write(NetworkWriter wtr)
+        {
+            wtr.Write(PetId);
+            wtr.Write(InitialSkin);
+            wtr.Write(FinalSkin);
+        }
+    }
+
+    /// <summary>A pet is gone (released, or fused into another).</summary>
+    public class DeletePet : OutgoingMessage
+    {
+        public int PetId { get; set; }
+
+        public override MessageId MessageId => MessageId.DELETE_PET;
+
+        public override void Write(NetworkWriter wtr) => wtr.Write(PetId);
+    }
+}
