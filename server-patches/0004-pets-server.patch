diff --git a/TK-Server/TKR.WorldServer/core/net/handlers/pets/PetHandlers.cs b/TK-Server/TKR.WorldServer/core/net/handlers/pets/PetHandlers.cs
new file mode 100644
index 0000000..283cbb9
--- /dev/null
+++ b/TK-Server/TKR.WorldServer/core/net/handlers/pets/PetHandlers.cs
@@ -0,0 +1,225 @@
+using System.Collections.Generic;
+using System.Linq;
+using TKR.Shared;
+using TKR.Shared.database.pet;
+using TKR.Shared.resources;
+using TKR.WorldServer.core.net.datas;
+using TKR.WorldServer.core.objects;
+using TKR.WorldServer.core.worlds;
+using TKR.WorldServer.core.worlds.impl;
+using TKR.WorldServer.networking;
+using TKR.WorldServer.networking.packets.outgoing.pets;
+
+// ROMTG-Doom: the client's pet requests, ported from NR-CORE (wServer/networking/handlers
+// PetUpgradeRequestHandler and ActivePetUpdateRequestHandler, AGPL-3.0). Both only work in your
+// own pet yard, where your pets are.
+namespace TKR.WorldServer.core.net.handlers.pets
+{
+    /// <summary>Feed a pet an item, fuse two pets, or grow the yard; paid in gold or fame.</summary>
+    public class PetUpgradeRequestHandler : IMessageHandler
+    {
+        public const int UPGRADE_PET_YARD = 1;
+        public const int FEED_PET = 2;
+        public const int FUSE_PET = 3;
+
+        public override MessageId MessageId => MessageId.PET_UPGRADE_REQUEST;
+
+        // [gold, fame]
+        private static readonly Dictionary<int, int[]> PetYardCost = new Dictionary<int, int[]>
+        {
+            { 1, new[] { 150, 500 } }, { 2, new[] { 400, 2000 } }, { 3, new[] { 1200, 25000 } }, { 4, new[] { 2000, 50000 } }
+        };
+        private static readonly Dictionary<PRarity, int[]> FeedCost = new Dictionary<PRarity, int[]>
+        {
+            { PRarity.Common, new[] { 5, 10 } }, { PRarity.Uncommon, new[] { 12, 30 } }, { PRarity.Rare, new[] { 30, 100 } },
+            { PRarity.Legendary, new[] { 60, 350 } }, { PRarity.Divine, new[] { 150, 1000 } }
+        };
+        private static readonly Dictionary<PRarity, int[]> FuseCost = new Dictionary<PRarity, int[]>
+        {
+            { PRarity.Common, new[] { 100, 300 } }, { PRarity.Uncommon, new[] { 240, 1000 } },
+            { PRarity.Rare, new[] { 600, 4000 } }, { PRarity.Legendary, new[] { 1800, 15000 } }
+        };
+
+        public override void Handle(Client client, NetworkReader rdr, ref TickTime time)
+        {
+            var transType = rdr.ReadByte();
+            var petId1 = rdr.ReadInt32();
+            var petId2 = rdr.ReadInt32();
+            var objectId = rdr.ReadInt32();
+            var slot = ObjectSlot.Read(rdr);
+            var currency = (CurrencyType)rdr.ReadByte();
+
+            if (client.Player == null || client.Player.World == null)
+                return;
+            if (currency != CurrencyType.Fame && currency != CurrencyType.Gold)
+            {
+                client.Player.SendError("Unsupported currency type.");
+                return;
+            }
+            var price = currency == CurrencyType.Gold ? 0 : 1;
+
+            switch (transType)
+            {
+                case UPGRADE_PET_YARD: UpgradePetYard(client, currency, price); break;
+                case FEED_PET: FeedPet(client, petId1, slot, currency, price); break;
+                case FUSE_PET: FusePet(client, petId1, petId2, currency, price); break;
+            }
+        }
+
+        private static void FusePet(Client client, int petId1, int petId2, CurrencyType currency, int price)
+        {
+            if (!(client.Player.World is PetYard petYard))
+                return;
+            var pet1 = petYard.Pets.Values.FirstOrDefault(p => p.PetId == petId1);
+            var pet2 = petYard.Pets.Values.FirstOrDefault(p => p.PetId == petId2);
+            if (pet1 == null || pet2 == null || pet1 == pet2 || pet1.Rarity != pet2.Rarity ||
+                pet1.Rarity == PRarity.Divine || pet1.Rarity == PRarity.Undefined)
+                return;
+            if (!TryDeduct(client, currency, FuseCost[pet1.Rarity][price]))
+                return;
+
+            var initialSkin = pet1.SkinId;
+            var result = pet1.Fuse(pet2);
+            if (result != 0 && result < pet1.Ability.Length)
+                client.SendPacket(new NewAbility { Type = pet1.Ability[result].Type });
+            else
+            {
+                // evolved: reload the pet with its new look
+                petYard.LeaveWorld(pet1);
+                var player = client.Player;
+                var pet = new Pet(client.GameServer, null, new DbPet(client.Account, pet1.PetId));
+                if (pet1.PlayerOwner == player)
+                {
+                    player.Pet = pet;
+                    pet.PlayerOwner = player;
+                    pet.Move(player.X, player.Y);
+                }
+                else
+                {
+                    var sp = petYard.GetPetSpawnPosition();
+                    pet.Move(sp.X + 0.5f, sp.Y + 0.5f);
+                }
+                petYard.EnterWorld(pet);
+                client.SendPacket(new EvolvePet { PetId = pet1.PetId, InitialSkin = initialSkin, FinalSkin = result });
+            }
+
+            // the other pet is gone
+            client.GameServer.Database.RemovePet(client.Account, pet2.PetId);
+            if (client.Player.PetId == pet2.PetId)
+                client.Player.PetId = 0;
+            petYard.LeaveWorld(pet2);
+            client.SendPacket(new DeletePet { PetId = pet2.PetId });
+        }
+
+        private static void FeedPet(Client client, int petId, ObjectSlot slot, CurrencyType currency, int price)
+        {
+            if (!(client.Player.World is PetYard petYard))
+                return;
+            var pet = petYard.Pets.Values.FirstOrDefault(p => p.PetId == petId);
+            var player = client.Player;
+            if (pet == null || slot.SlotId >= player.Inventory.Length)
+                return;
+            var item = player.Inventory[slot.SlotId];
+            if (item == null || item.ObjectType != slot.ObjectType)
+                return;
+            if (!TryDeduct(client, currency, FeedCost[pet.Rarity][price]))
+                return;
+            player.Inventory[slot.SlotId] = null;
+            if (!pet.Feed(item.FeedPower))
+                player.SendInfo("This pet can't grow any more until you fuse it.");
+        }
+
+        private static void UpgradePetYard(Client client, CurrencyType currency, int price)
+        {
+            var acc = client.Account;
+            if (acc.PetYardType > 4)
+            {
+                client.Player.SendError("Your pet yard is already as big as it gets.");
+                return;
+            }
+            if (!TryDeduct(client, currency, PetYardCost[acc.PetYardType][price]))
+                return;
+            acc.PetYardType++;
+            acc.FlushAsync();
+            client.SendPacket(new PetYardUpdate { Type = acc.PetYardType });
+        }
+
+        private static bool TryDeduct(Client client, CurrencyType currency, int amount)
+        {
+            var acc = client.Account;
+            var db = client.GameServer.Database;
+            var player = client.Player;
+            if (currency == CurrencyType.Fame)
+            {
+                if (acc.Fame < amount)
+                {
+                    player.SendError("Not enough fame.");
+                    return false;
+                }
+                db.UpdateFame(acc, -amount);
+                player.CurrentFame = acc.Fame;
+                return true;
+            }
+            if (acc.Credits < amount)
+            {
+                player.SendError("Not enough gold.");
+                return false;
+            }
+            db.UpdateCredit(acc, -amount);
+            player.Credits = acc.Credits;
+            return true;
+        }
+    }
+
+    /// <summary>Make a pet your active pet (it follows you out of the yard), stop it, or release it.</summary>
+    public class ActivePetUpdateRequestHandler : IMessageHandler
+    {
+        public const int Follow = 1;
+        public const int Unfollow = 2;
+        public const int Release = 3;
+
+        public override MessageId MessageId => MessageId.ACTIVE_PET_UPDATE_REQUEST;
+
+        public override void Handle(Client client, NetworkReader rdr, ref TickTime time)
+        {
+            var command = rdr.ReadByte();
+            var instanceId = rdr.ReadInt32();
+            var player = client.Player;
+            if (!(player?.World is PetYard petYard))
+                return;
+            var pet = petYard.Pets.Values.FirstOrDefault(p => p.PetId == instanceId);
+            if (pet == null)
+                return;
+
+            switch (command)
+            {
+                case Follow:
+                    if (player.Pet != null)
+                        player.Pet.PlayerOwner = null;
+                    pet.PlayerOwner = player;
+                    player.Pet = pet;
+                    player.PetId = pet.PetId;
+                    client.SendPacket(new ActivePetUpdate { InstanceId = pet.PetId });
+                    break;
+                case Unfollow:
+                    pet.PlayerOwner = null;
+                    player.Pet = null;
+                    player.PetId = 0;
+                    client.SendPacket(new ActivePetUpdate { InstanceId = -1 });
+                    break;
+                case Release:
+                    if (pet.PlayerOwner != null)
+                    {
+                        pet.PlayerOwner.Pet = null;
+                        pet.PlayerOwner = null;
+                        player.PetId = 0;
+                        client.SendPacket(new ActivePetUpdate { InstanceId = -1 });
+                    }
+                    client.GameServer.Database.RemovePet(client.Account, pet.PetId);
+                    petYard.LeaveWorld(pet);
+                    client.SendPacket(new DeletePet { PetId = pet.PetId });
+                    break;
+            }
+        }
+    }
+}
