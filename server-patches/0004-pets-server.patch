         {
             if (Definitions.TryGetValue(entity.ObjectType, out Tuple<State, Loot> def))
                 entity.SwitchTo(def.Item1);
+            else if (entity is Pet && entity.GameServer.Resources.GameData.Pets.ContainsKey(entity.ObjectType))
+                entity.SwitchTo(PetState);   // ROMTG-Doom: every RotMG pet
+        }
+
+        /// <summary>ROMTG-Doom: what every RotMG pet does; each behaviour only acts if the pet has
+        /// its ability (logic/behaviors/pets).</summary>
+        private static State _petState;
+        private static State PetState
+        {
+            get
+            {
+                if (_petState != null)
