--- a/TK-Server/TKR.WorldServer/core/objects/Pet.cs
+++ b/TK-Server/TKR.WorldServer/core/objects/Pet.cs
@@ -1,13 +1,316 @@
-﻿namespace TKR.WorldServer.core.objects
+﻿using System;
+using System.Collections.Generic;
+using System.Linq;
+using TKR.Shared.database.pet;
+using TKR.Shared.resources;
+using TKR.WorldServer.core.net.stats;
+
+namespace TKR.WorldServer.core.objects
 {
+    /// <summary>
+    /// A pet. Two kinds share this class:
+    /// - TK's own cosmetic followers (items with a "Pet" effect): just an object type.
+    /// - ROMTG-Doom: RotMG's pets, ported from NR-CORE (wServer/realm/entities/Pet.cs, AGPL-3.0):
+    ///   stored per account (DbPet), with a family, rarity, a skin and three abilities that level up
+    ///   when the pet is fed. Their behaviour (follow, heal, magic heal, attacks...) is
+    ///   logic/behaviors/pets, given to every RotMG pet by BehaviorDb.
+    /// </summary>
     public class Pet : Entity, IPlayer
     {
+        public Player PlayerOwner { get; set; }
+
+        // RotMG pets only (0 / null for TK's cosmetic followers).
+        public int PetId { get; private set; }
+        public PFamily Family { get; private set; }
+        public PRarity Rarity { get; private set; }
+        public int SkinId { get; private set; }
+        public string Skin { get; private set; }
+        public int MaxLevel { get; private set; }
+        public PetAbility[] Ability { get; private set; } = Array.Empty<PetAbility>();
+        public bool IsRotmgPet => _dbPet != null || Ability.Length > 0;
+
+        private readonly DbPet _dbPet;
+
+        /// <summary>TK's cosmetic follower.</summary>
         public Pet(GameServer manager, Player player, ushort objType) : base(manager, objType) => PlayerOwner = player;
 
-        public Player PlayerOwner { get; set; }
+        /// <summary>A RotMG pet from the account's pets.</summary>
+        public Pet(GameServer manager, Player playerOwner, DbPet pet) : base(manager, pet.ObjectType)
+        {
+            PlayerOwner = playerOwner;
+            _dbPet = pet;
+
+            var gameData = manager.Resources.GameData;
+            var petDesc = gameData.Pets[pet.ObjectType];
+            SetLook(pet.SkinType != 0 && gameData.PetSkins.ContainsKey((ushort)pet.SkinType)
+                ? (ushort)pet.SkinType
+                : DefaultSkin(gameData, petDesc));
+
+            Family = petDesc.Family;
+            SetDefaultSize(petDesc.MinSize);
+
+            PetId = pet.PetId;
+            Rarity = pet.Rarity;
+            MaxLevel = pet.MaxLevel;
+            Ability = new PetAbility[DbPet.NumAbilities];
+            for (var i = 0; i < Ability.Length; i++)
+                Ability[i] = new PetAbility(this, pet, i);
+        }
+
+        private static ushort DefaultSkin(XmlData gameData, PetDesc petDesc) =>
+            petDesc.DefaultSkin != null && gameData.IdToObjectType.TryGetValue(petDesc.DefaultSkin, out var skin) ? skin : petDesc.ObjectType;
+
+        private void SetLook(ushort skinType)
+        {
+            var gameData = GameServer.Resources.GameData;
+            SkinId = skinType;
+            Skin = gameData.PetSkins.TryGetValue(skinType, out var desc) ? desc.DisplayName : gameData.ObjectDescs[ObjectType].DisplayName;
+        }
+
+        protected override void ExportStats(IDictionary<StatDataType, object> stats, bool isOtherPlayer)
+        {
+            base.ExportStats(stats, isOtherPlayer);
+            if (!IsRotmgPet)
+                return;
+            stats[StatDataType.PetType] = (int)ObjectType;
+            stats[StatDataType.PetRarity] = (int)Rarity;
+            stats[StatDataType.PetSkinType] = SkinId;
+            stats[StatDataType.PetSkin] = Skin ?? "";
+            stats[StatDataType.PetId] = PetId;
+            stats[StatDataType.PetMaxLevel] = MaxLevel;
+            stats[StatDataType.PetAbilityPower1] = Ability[0].Power;
+            stats[StatDataType.PetAbilityPower2] = Ability[1].Power;
+            stats[StatDataType.PetAbilityPower3] = Ability[2].Power;
+            stats[StatDataType.PetAbilityLevel1] = Ability[0].Level;
+            stats[StatDataType.PetAbilityLevel2] = Ability[1].Level;
+            stats[StatDataType.PetAbilityLevel3] = Ability[2].Level;
+            stats[StatDataType.PetAbilityType1] = (int)Ability[0].Type;
+            stats[StatDataType.PetAbilityType2] = (int)Ability[1].Type;
+            stats[StatDataType.PetAbilityType3] = (int)Ability[2].Type;
+        }
 
         public void Damage(int dmg, Entity src) { }
 
         public bool IsVisibleToEnemy() => false;
+
+        /// <summary>Hatches an egg: a random pet of the egg's family and rarity, saved to the account.</summary>
+        public static Pet Create(GameServer manager, Player player, Item egg)
+        {
+            // there are no explicit uncommon/legendary pets, so this is needed
+            var rarity = egg.Rarity;
+            switch (rarity)
+            {
+                case PRarity.Uncommon: rarity = PRarity.Common; break;
+                case PRarity.Legendary: rarity = PRarity.Rare; break;
+            }
+
+            var petDesc = GetRandomPetDesc(manager, rarity, egg.Family);
+            if (petDesc == null)
+            {
+                player.SendError($"Bad egg. Family: {egg.Family} and Rarity: {egg.Rarity} combination does not exist.");
+                return null;
+            }
+
+            var acc = player.Client.Account;
+            var dbPet = manager.Database.NewPet(acc);
+            if (dbPet == null)
+            {
+                player.SendError("Pet cap has been reached. Please release a pet before adding new ones.");
+                return null;
+            }
+            dbPet.ObjectType = petDesc.ObjectType;
+            dbPet.Rarity = egg.Rarity;
+            dbPet.MaxLevel = GetRarityMaxLevel(egg.Rarity);
+
+            var pet = new Pet(manager, player, dbPet);
+            pet.Rarity = egg.Rarity;
+            pet.MaxLevel = GetRarityMaxLevel(egg.Rarity);
+            InitializeAbilities(manager, pet, petDesc);
+            pet.Feed(GetNeededPower(GetRarityMaxLevel(egg.Rarity - 1) - 1));
+            pet.Save();
+            return pet;
+        }
+
+        public static int GetNeededPower(int currentLevel) =>
+            (int)(20 * (1 - Math.Pow(1.08, currentLevel)) / (1 - 1.08)) + 1;
+
+        private static PetDesc GetRandomPetDesc(GameServer manager, PRarity rarity = PRarity.Undefined, PFamily family = PFamily.Undefined)
+        {
+            var petDescs = manager.Resources.GameData.Pets.Values
+                .Where(d => rarity == PRarity.Undefined || rarity == d.Rarity)
+                .Where(d => family == PFamily.Undefined || family == d.Family)
+                .ToArray();
+            return petDescs.Length == 0 ? null : petDescs[Random.Shared.Next(petDescs.Length)];
+        }
+
+        public static int GetRarityMaxLevel(PRarity rarity)
+        {
+            switch (rarity)
+            {
+                case PRarity.Divine: return 100;
+                case PRarity.Legendary: return 90;
+                case PRarity.Rare: return 70;
+                case PRarity.Uncommon: return 50;
+                case PRarity.Common: return 30;
+                default: return 1;
+            }
+        }
+
+        private static void InitializeAbilities(GameServer manager, Pet pet, PetDesc petDesc)
+        {
+            var abilities = manager.Resources.GameData.PetAbilities.Keys.Select(a => (PAbility)a).ToList();
+            if (abilities.Count <= 0)
+                throw new Exception("Missing pet abilities (is romtg_pets.xml in resources/xml? run rotmg-doom/scripts/pets.py).");
+
+            var ability = petDesc.FirstAbility;
+            if (ability == PAbility.Undefined)
+                ability = abilities[Random.Shared.Next(abilities.Count)];
+
+            for (var i = 0; i < DbPet.NumAbilities; i++)
+            {
+                pet.Ability[i].Initialize(ability, 1);
+
+                if (ability == PAbility.AttackClose || ability == PAbility.AttackFar || ability == PAbility.AttackMid)
+                {
+                    abilities.Remove(PAbility.AttackClose);
+                    abilities.Remove(PAbility.AttackFar);
+                    abilities.Remove(PAbility.AttackMid);
+                }
+                else
+                    abilities.Remove(ability);
+
+                if (abilities.Count == 0)
+                    break;
+                ability = abilities[Random.Shared.Next(abilities.Count)];
+            }
+        }
+
+        /// <summary>Feeds every ability (the second and third get less). False if there's nothing
+        /// left to level.</summary>
+        public bool Feed(int feedPower)
+        {
+            // don't feed abilities if the enabled abilities are maxed
+            if (Ability[0].Level >= MaxLevel && Rarity < PRarity.Uncommon ||
+                Ability[1].Level >= MaxLevel && Rarity < PRarity.Legendary ||
+                Ability[2].Level >= MaxLevel)
+                return false;
+
+            foreach (var a in Ability)
+                a.Feed(feedPower);
+            Save();
+            return true;
+        }
+
+        public void Save()
+        {
+            if (_dbPet == null)
+                return;
+            _dbPet.ObjectType = ObjectType;
+            _dbPet.Rarity = Rarity;
+            _dbPet.MaxLevel = MaxLevel;
+            _dbPet.SkinType = SkinId;
+            for (var i = 0; i < _dbPet.Ability.Length; i++)
+            {
+                _dbPet.Ability[i].Type = Ability[i].Type;
+                _dbPet.Ability[i].Level = Ability[i].Level;
+                _dbPet.Ability[i].Power = Ability[i].Power;
+            }
+            _dbPet.FlushAsync();
+        }
+
+        /// <summary>A pet stone: a new look, kept.</summary>
+        public void Reskin(ushort skinType)
+        {
+            SetLook(skinType);
+            Save();
+        }
+
+        /// <summary>Fuses `pet` into this one. Returns 1 or 2 when it only gained rarity, the new
+        /// skin's type when it evolved, 0 otherwise.</summary>
+        public int Fuse(Pet pet)
+        {
+            FuseStats(pet);
+
+            if (Rarity == PRarity.Uncommon || Rarity == PRarity.Legendary)
+            {
+                Save();
+                return Rarity == PRarity.Uncommon ? 1 : 2;
+            }
+
+            // evolve
+            var petDesc = GetRandomPetDesc(GameServer, Rarity, Family);
+            if (petDesc != null)
+            {
+                ObjectType = petDesc.ObjectType;
+                SetLook(DefaultSkin(GameServer.Resources.GameData, petDesc));
+                Save();
+                return SkinId;
+            }
+            return 0;
+        }
+
+        private void FuseStats(Pet pet)
+        {
+            for (var i = 0; i < Ability.Length; i++)
+                Ability[i].Initialize(Ability[i].Type, (Ability[i].Level + pet.Ability[i].Level) / 2);
+            MaxLevel = Math.Min(100, 20 + Ability[0].Level);
+            Rarity += 1;
+        }
+    }
+
+    public class PetAbility
+    {
+        public PAbility Type { get; private set; }
+        public int Level { get; private set; }
+        public int Power { get; private set; }
+
+        private readonly Pet _owner;
+        private readonly int _abilityId;
+        private int _nextPowerGoal;
+
+        public PetAbility(Pet owner, DbPet dbPet, int abilityId)
+        {
+            _owner = owner;
+            _abilityId = abilityId;
+
+            var ability = dbPet.Ability[abilityId];
+            Type = ability.Type;
+            Level = Math.Max(1, ability.Level);
+            Power = ability.Power;
+            _nextPowerGoal = Pet.GetNeededPower(Level);
+        }
+
+        public void Initialize(PAbility ability, int level)
+        {
+            Type = ability;
+            Level = Math.Max(1, level);
+            Power = Pet.GetNeededPower(Level - 1);
+            _nextPowerGoal = Pet.GetNeededPower(Level);
+        }
+
+        public void Feed(int feedPower)
+        {
+            if (Level >= _owner.MaxLevel)
+                return;
+
+            // the second and third abilities level slower
+            var p = feedPower;
+            switch (_abilityId)
+            {
+                case 0: break;
+                case 1: p = (int)(p * .65f); break;
+                case 2: p = (int)(p * .30f); break;
+                default: p = (int)(p * .10f); break;
+            }
+
+            Power += p;
+            while (Power >= _nextPowerGoal && Level < _owner.MaxLevel)
+            {
+                Level++;
+                if (Level >= _owner.MaxLevel)
+                    Power = _nextPowerGoal;
+                _nextPowerGoal = Pet.GetNeededPower(Level);
+            }
+        }
     }
 }
