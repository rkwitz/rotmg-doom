+                    new behaviors.pets.PetHeal(),
+                    new behaviors.pets.PetMagicHeal(),
+                    new behaviors.pets.PetShoot(PAbility.AttackClose, 3, 1.6),
+                    new behaviors.pets.PetShoot(PAbility.AttackMid, 6, 1.0),
+                    new behaviors.pets.PetShoot(PAbility.AttackFar, 9, 0.6),
+                    new behaviors.pets.PetZap(),
+                    new behaviors.pets.PetSavage(),
