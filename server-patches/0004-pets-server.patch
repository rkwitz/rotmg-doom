diff --git a/TK-Server/TKR.WorldServer/logic/behaviors/pets/PetBehaviors.cs b/TK-Server/TKR.WorldServer/logic/behaviors/pets/PetBehaviors.cs
new file mode 100644
index 0000000..6de5434
--- /dev/null
+++ b/TK-Server/TKR.WorldServer/logic/behaviors/pets/PetBehaviors.cs
@@ -0,0 +1,298 @@
+using System;
+using System.Linq;
+using TKR.Shared.resources;
+using TKR.WorldServer.core.net.datas;
+using TKR.WorldServer.core.objects;
+using TKR.WorldServer.core.structures;
+using TKR.WorldServer.core.worlds;
+using TKR.WorldServer.core.worlds.impl;
+using TKR.WorldServer.networking.packets.outgoing;
+using TKR.WorldServer.utils;
+
+// ROMTG-Doom: what RotMG's pets do, for TKR. Follow, Heal and Magic Heal are ported from NR-CORE
+// (wServer/logic/behaviors/PetBehaviors, AGPL-3.0); NR-CORE left the others empty, so the attacks,
+// Electric, Savage, Decoy and Rising Fury are written here after RotMG's descriptions.
+//
+// Unlike NR-CORE, nothing about a pet is kept in the behaviour itself: one set of these serves
+// every pet (BehaviorDb.PetState), so the pet and its ability are looked up from the host each tick.
+namespace TKR.WorldServer.logic.behaviors.pets
+{
+    internal abstract class PetBehavior : Behavior
+    {
+        private readonly bool _requiresOwner;
+        protected PAbility AbilityType { get; }
+
+        protected PetBehavior(PAbility ability, bool requiresOwner = true)
+        {
+            AbilityType = ability;
+            _requiresOwner = requiresOwner;
+        }
+
+        protected override void OnStateEntry(Entity host, TickTime time, ref object state) => state = 0;
+
+        protected sealed override void TickCore(Entity host, TickTime time, ref object state)
+        {
+            if (!(host is Pet pet) || pet.World == null)
+                return;
+            var ability = pet.Ability.FirstOrDefault(a => a.Type == AbilityType);
+            if (ability == null || ability.Level <= 0)
+                return;
+            var owner = pet.PlayerOwner;
+            if (_requiresOwner && (owner == null || owner.World != pet.World || owner.Dead))
+                return;
+
+            var cool = state is int c ? c : 0;
+            if (cool > 0)
+            {
+                state = cool - time.ElapsedMsDelta;
+                return;
+            }
+            state = Act(pet, owner, ability, time);
+        }
+
+        /// <summary>Does the ability once; returns the milliseconds until it may again.</summary>
+        protected abstract int Act(Pet pet, Player owner, PetAbility ability, TickTime time);
+
+        /// <summary>NR-CORE's cooldown curve: long at level 1, short at high levels.</summary>
+        protected static int DiminishingReturnsCooldown(int min, int max, int level, double scale)
+        {
+            var mult = Math.Max(0, level) / scale;
+            var trinum = (Math.Sqrt(8.0 * mult + 1.0) - 1.0) / 2.0;
+            return Math.Max(min * 1000, (int)((max - (trinum * scale) + min) * 1000));
+        }
+
+        protected static void Trail(Entity from, Entity to, uint color) =>
+            from.World.BroadcastIfVisible(new ShowEffect
+            {
+                EffectType = EffectType.Trail,
+                TargetObjectId = from.Id,
+                Pos1 = new Position { X = to.X, Y = to.Y },
+                Color = new ARGB(color)
+            }, from);
+
+        protected static void Note(Player owner, string text, uint color) =>
+            owner.World.BroadcastIfVisible(new Notification { ObjectId = owner.Id, Message = text, Color = new ARGB(color) }, owner);
+
+        protected static Enemy NearestEnemy(Entity from, double range) =>
+            from.GetNearestEntity(range, false, e => e is Enemy en && !en.HasConditionEffect(ConditionEffectIndex.Invincible)) as Enemy;
+    }
+
+    /// <summary>Stays close to its player (ported from NR-CORE's PetFollow); with no player (in
+    /// the pet yard), roams the lawn (PetRegion) like NR-CORE's PetWander.</summary>
+    internal class PetFollow : Behavior
+    {
+        private class Roam { public float X, Y; public int Wait; }
+
+        private static void Wander(Pet pet, TickTime time, ref object state)
+        {
+            var r = state as Roam;
+            if (r == null)
+                state = r = new Roam { X = pet.X, Y = pet.Y, Wait = Random.Shared.Next(500, 3000) };
+            if (r.Wait > 0)
+            {
+                r.Wait -= time.ElapsedMsDelta;
+                return;
+            }
+            var dx = r.X - pet.X;
+            var dy = r.Y - pet.Y;
+            var len = Math.Sqrt(dx * dx + dy * dy);
+            if (len < 0.2)
+            {
+                // somewhere new on the lawn, not far
+                for (var tries = 0; tries < 6; tries++)
+                {
+                    var tx = pet.X + (float)(Random.Shared.NextDouble() * 6 - 3);
+                    var ty = pet.Y + (float)(Random.Shared.NextDouble() * 6 - 3);
+                    if (tx < 1 || ty < 1 || tx >= pet.World.Map.Width - 1 || ty >= pet.World.Map.Height - 1)
+                        continue;
+                    var tile = pet.World.Map[(int)tx, (int)ty];
+                    if (tile != null && tile.Region == TileRegion.PetRegion)
+                    {
+                        r.X = tx;
+                        r.Y = ty;
+                        break;
+                    }
+                }
+                r.Wait = Random.Shared.Next(1000, 4000);
+                return;
+            }
+            var dist = (float)Math.Min(len, pet.GetSpeed(2.0f) * time.DeltaTime);
+            pet.ValidateAndMove(pet.X + (float)(dx / len) * dist, pet.Y + (float)(dy / len) * dist);
+        }
+
+        protected override void TickCore(Entity host, TickTime time, ref object state)
+        {
+            if (!(host is Pet pet) || host.World == null)
+                return;
+            if (pet.PlayerOwner == null)
+            {
+                Wander(pet, time, ref state);   // in the yard: roam the lawn
+                return;
+            }
+            var player = host.World.GetEntity(pet.PlayerOwner.Id) as Player;
+            if (player == null)
+            {
+                // the player left this world: so does the pet (the pet yard keeps its pets)
+                if (!(host.World is PetYard))
+                    host.World.LeaveWorld(host);
+                return;
+            }
+            var dx = player.X - host.X;
+            var dy = player.Y - host.Y;
+            var len = Math.Sqrt(dx * dx + dy * dy);
+            if (len > 20)
+                host.Move(player.X, player.Y);
+            else if (len > 1)
+            {
+                var speed = len > 2 ? 0.7f + player.Stats[4] / 100f : 0.5f;
+                var dist = host.GetSpeed(speed * 5.55f + 0.74f) * time.DeltaTime;
+                dist = (float)Math.Min(dist, len - 0.8);
+                host.ValidateAndMove(host.X + (float)(dx / len) * dist, host.Y + (float)(dy / len) * dist);
+            }
+        }
+    }
+
+    /// <summary>Heals its player now and then (ported from NR-CORE's PetHeal).</summary>
+    internal class PetHeal : PetBehavior
+    {
+        public PetHeal() : base(PAbility.Heal) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            var cool = DiminishingReturnsCooldown(1, 10, ability.Level, 0.5264);
+            var heal = (int)Math.Round(5.83283522976111E-07 * Math.Pow(ability.Level, 4)
+                - 0.0000469692310249639 * Math.Pow(ability.Level, 3)
+                + 0.0076256636031656 * Math.Pow(ability.Level, 2)
+                - 0.0776182463432286 * ability.Level + 10.0998122309192);
+            var newHp = Math.Min(owner.Stats[0], owner.HP + heal);
+            if (newHp == owner.HP)
+                return 250;
+            if (owner.HasConditionEffect(ConditionEffectIndex.Sick))
+            {
+                Trail(pet, owner, 0xffffffff);
+                Note(owner, "No Effect", 0xffff0000);
+                return cool;
+            }
+            Note(owner, "+" + (newHp - owner.HP), 0xff00ff00);
+            owner.HP = newHp;
+            Trail(pet, owner, 0xffffffff);
+            return cool;
+        }
+    }
+
+    /// <summary>Restores its player's MP now and then (ported from NR-CORE's PetMagicHeal).</summary>
+    internal class PetMagicHeal : PetBehavior
+    {
+        public PetMagicHeal() : base(PAbility.MagicHeal) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            var cool = DiminishingReturnsCooldown(1, 10, ability.Level, 0.5264);
+            var heal = (int)Math.Round(6.0 + ability.Level * 0.4 + Math.Pow(ability.Level, 2) * 0.004);
+            var newMp = Math.Min(owner.Stats[1], owner.MP + heal);
+            if (newMp == owner.MP)
+                return 250;
+            if (owner.HasConditionEffect(ConditionEffectIndex.Quiet))
+            {
+                Note(owner, "No Effect", 0xffff0000);
+                return cool;
+            }
+            Note(owner, "+" + (newMp - owner.MP), 0xff6084e0);
+            owner.MP = newMp;
+            Trail(pet, owner, 0xff6084e0);
+            return cool;
+        }
+    }
+
+    /// <summary>Attack Close / Mid / Far: hits the nearest enemy in its range. Close hits hardest,
+    /// far reaches furthest.</summary>
+    internal class PetShoot : PetBehavior
+    {
+        private readonly double _range;
+        private readonly double _damageScale;
+
+        public PetShoot(PAbility ability, double range, double damageScale) : base(ability)
+        {
+            _range = range;
+            _damageScale = damageScale;
+        }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            var enemy = NearestEnemy(pet, _range);
+            if (enemy == null)
+                return 250;
+            var damage = (int)((10 + ability.Level * 2.5) * _damageScale);
+            Trail(pet, enemy, 0xffffd060);
+            enemy.Damage(owner, ref time, damage, false);
+            return Math.Max(400, 2000 - ability.Level * 15);
+        }
+    }
+
+    /// <summary>Electric: zaps the nearest enemy, and stuns it briefly.</summary>
+    internal class PetZap : PetBehavior
+    {
+        public PetZap() : base(PAbility.Electric) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            var enemy = NearestEnemy(pet, 6);
+            if (enemy == null)
+                return 250;
+            Trail(pet, enemy, 0xff40c0ff);
+            enemy.Damage(owner, ref time, 15 + ability.Level * 3, true,
+                false, new ConditionEffect(ConditionEffectIndex.Paralyzed, 500 + ability.Level * 15));
+            return DiminishingReturnsCooldown(1, 8, ability.Level, 0.5264);
+        }
+    }
+
+    /// <summary>Savage: lunges at the nearest close enemy and bites, ignoring its defense.</summary>
+    internal class PetSavage : PetBehavior
+    {
+        public PetSavage() : base(PAbility.Savage) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            var enemy = NearestEnemy(pet, 4);
+            if (enemy == null)
+                return 250;
+            Trail(pet, enemy, 0xffff3030);
+            enemy.Damage(owner, ref time, 20 + ability.Level * 4, true);
+            return DiminishingReturnsCooldown(1, 6, ability.Level, 0.5264);
+        }
+    }
+
+    /// <summary>Decoy: drops a decoy of its player for enemies to chase.</summary>
+    internal class PetDecoy : PetBehavior
+    {
+        public PetDecoy() : base(PAbility.Decoy) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            if (NearestEnemy(pet, 10) == null)
+                return 500;
+            var decoy = new Decoy(owner, 1500 + ability.Level * 30);
+            decoy.Move(pet.X, pet.Y);
+            pet.World.EnterWorld(decoy);
+            return DiminishingReturnsCooldown(5, 30, ability.Level, 0.5264);
+        }
+    }
+
+    /// <summary>Rising Fury: when its player is badly hurt, makes them berserk and damaging for a while.</summary>
+    internal class PetRisingFury : PetBehavior
+    {
+        public PetRisingFury() : base(PAbility.RisingFury) { }
+
+        protected override int Act(Pet pet, Player owner, PetAbility ability, TickTime time)
+        {
+            if (owner.HP > owner.Stats[0] * 0.3)
+                return 250;
+            var duration = 2000 + ability.Level * 40;
+            owner.ApplyConditionEffect(new ConditionEffect(ConditionEffectIndex.Berserk, duration),
+                new ConditionEffect(ConditionEffectIndex.Damaging, duration));
+            Trail(pet, owner, 0xffff8000);
+            Note(owner, "Rising Fury!", 0xffff8000);
+            return DiminishingReturnsCooldown(10, 60, ability.Level, 0.5264);
+        }
+    }
+}
