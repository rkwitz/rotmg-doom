index 0000000..4883d6c
--- /dev/null
+++ b/TK-Server/TKR.WorldServer/core/worlds/impl/PetYard.cs
@@ -0,0 +1,94 @@
+using System.Linq;
+using TKR.Shared.database.pet;
+using TKR.Shared.resources;
+using TKR.WorldServer.core.objects;
+using TKR.WorldServer.core.structures;
+using TKR.WorldServer.networking;
+
+// ROMTG-Doom: your pet yard, ported from NR-CORE (wServer/realm/worlds/logic/PetYard.cs, AGPL-3.0).
+// One per visit, only for its owner (like the vault): every pet you own roams the lawn
+// (PetRegion), and the Pet Upgrader there feeds and fuses them.
+namespace TKR.WorldServer.core.worlds.impl
+{
+    public sealed class PetYard : World
+    {
+        public int AccountId { get; private set; }
+        public Client Client { get; private set; }
+
+        public PetYard(GameServer gameServer, int id, WorldResource resource, World parent) : base(gameServer, id, resource, parent)
+        {
+        }
+
+        public override bool AllowedAccess(Client client) => AccountId == client.Account.AccountId || client.Rank.IsAdmin;
+
+        public void SetOwner(int accountId) => AccountId = accountId;
+
+        /// <summary>Its owner arrived: their pets come out.</summary>
+        public void SetClient(Client client)
+        {
+            if (Client != null)
+                return;
+            Client = client;
+            AccountId = client.Account.AccountId;
+
+            var acc = client.Account;
+            var removed = false;
+            foreach (var petId in acc.PetList)
+            {
+                var dbPet = new DbPet(acc, petId);
+                if (dbPet.ObjectType == 0 || !GameServer.Resources.GameData.Pets.ContainsKey(dbPet.ObjectType))
+                {
+                    removed = true;
+                    GameServer.Database.RemovePet(acc, petId);
+                    continue;
+                }
+                var pet = new Pet(GameServer, null, dbPet);
+                var pos = GetPetSpawnPosition();
+                pet.Move(pos.X + 0.5f, pos.Y + 0.5f);
+                EnterWorld(pet);
+            }
+            if (removed)
+                acc.Reload();
+        }
+
+        /// <summary>Your first visit (once per account): a common egg to hatch, if you have room.
+        /// Called when your character arrives in the yard.</summary>
+        public void GiveStarterEgg(Client client)
+        {
+            var acc = client.Account;
+            if (acc.PetList.Length > 0 || acc.StarterPetEgg || client.Player == null)
+                return;
+            var gameData = GameServer.Resources.GameData;
+            var egg = gameData.Items.Values.FirstOrDefault(i => i.Rarity == PRarity.Common &&
+                i.ActivateEffects.Any(a => a.Effect == ActivateEffects.CreatePet));
+            if (egg == null)
+                return;
+            var inv = client.Player.Inventory;
+            for (var slot = 4; slot < 12 && slot < inv.Length; slot++)
+                if (inv[slot] == null)
+                {
+                    inv[slot] = egg;
+                    acc.StarterPetEgg = true;
+                    acc.FlushAsync();
+                    client.Player.SendInfo($"Welcome to your pet yard! Here's a {egg.DisplayName} to hatch: use it from your inventory.");
+                    return;
+                }
+        }
+
+        public Position GetPetSpawnPosition()
+        {
+            var spots = Map.Regions.Where(t => t.Value == TileRegion.PetRegion).ToArray();
+            if (spots.Length == 0)
+                return new Position { X = Map.Width / 2, Y = Map.Height / 2 };
+            var spot = spots[System.Random.Shared.Next(spots.Length)];
+            return new Position { X = spot.Key.X, Y = spot.Key.Y };
+        }
+
+        public override void LeaveWorld(Entity entity)
+        {
+            base.LeaveWorld(entity);
+            if (entity is Player)
+                FlagForClose();
+        }
+    }
+}
