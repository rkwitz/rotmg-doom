diff --git a/TK-Server/TKR.Shared/database/pet/DbPet.cs b/TK-Server/TKR.Shared/database/pet/DbPet.cs
new file mode 100644
index 0000000..66d470a
--- /dev/null
+++ b/TK-Server/TKR.Shared/database/pet/DbPet.cs
@@ -0,0 +1,86 @@
+using StackExchange.Redis;
+using TKR.Shared.database.account;
+using TKR.Shared.resources;
+
+// ROMTG-Doom: an account's pets, ported from NR-CORE (common/DbModels.cs DbPet, AGPL-3.0).
+// Stored as hashes "pet.{accountId}.{petId}"; the account keeps the list of its pet ids.
+namespace TKR.Shared.database.pet
+{
+    public class DbPetAbility
+    {
+        private readonly DbPet _owner;
+        private readonly string _typeKey;
+        private readonly string _levelKey;
+        private readonly string _powerKey;
+
+        public DbPetAbility(DbPet owner, int abilityId)
+        {
+            _owner = owner;
+            _typeKey = $"A{abilityId}Type";
+            _levelKey = $"A{abilityId}Level";
+            _powerKey = $"A{abilityId}Power";
+        }
+
+        public PAbility Type { get => (PAbility)_owner.Get(_typeKey); set => _owner.Set(_typeKey, (int)value); }
+        public int Level { get => _owner.Get(_levelKey); set => _owner.Set(_levelKey, value); }
+        public int Power { get => _owner.Get(_powerKey); set => _owner.Set(_powerKey, value); }
+    }
+
+    public class DbPet : RedisObject
+    {
+        public const int NumAbilities = 3;
+
+        public DbAccount Account { get; private set; }
+        public int PetId { get; set; }
+        public DbPetAbility[] Ability { get; private set; }
+
+        public DbPet(DbAccount acc, int petId)
+        {
+            Account = acc;
+            PetId = petId;
+
+            Init(acc.Database, $"pet.{acc.AccountId}.{petId}");
+
+            Ability = new DbPetAbility[NumAbilities];
+            for (var i = 0; i < NumAbilities; i++)
+                Ability[i] = new DbPetAbility(this, i);
+        }
+
+        public ushort ObjectType { get => GetValue<ushort>("objType"); set => SetValue("objType", value); }
+        public PRarity Rarity { get => (PRarity)GetValue<ushort>("rarity"); set => SetValue("rarity", (ushort)value); }
+        public int MaxLevel { get => GetValue<int>("maxLevel"); set => SetValue("maxLevel", value); }
+        /// <summary>The look chosen with a pet stone (0: the pet's own).</summary>
+        public int SkinType { get => GetValue<int>("skinType"); set => SetValue("skinType", value); }
+
+        internal int Get(string key) => GetValue<int>(key);
+        internal void Set(string key, int value) => SetValue(key, value);
+    }
+
+    public static class PetDatabase
+    {
+        public const int MaxPetCount = 64;
+
+        public static DbPet NewPet(this Database db, DbAccount acc)
+        {
+            var petList = new System.Collections.Generic.List<int>(acc.PetList);
+            if (petList.Count >= MaxPetCount)
+                return null;
+            var nextPetId = (int)db.Conn.StringIncrement("nextPetId");
+            petList.Add(nextPetId);
+            acc.PetList = petList.ToArray();
+            acc.FlushAsync();
+            return new DbPet(acc, nextPetId);
+        }
+
+        public static bool RemovePet(this Database db, DbAccount acc, int petId)
+        {
+            var petList = new System.Collections.Generic.List<int>(acc.PetList);
+            if (!petList.Remove(petId))
+                return false;
+            acc.PetList = petList.ToArray();
+            acc.FlushAsync();
+            db.Conn.KeyDeleteAsync($"pet.{acc.AccountId}.{petId}", CommandFlags.FireAndForget);
+            return true;
+        }
+    }
+}
