+      /** A burst of particles (a shot hitting a wall or an enemy, something dying: RotMG's
+       *  HitEffect and ExplosionEffect) for Doom to draw too, while it shows the game:
+       *  `burst X Y N SIZE VX VY SPREAD RGB,RGB...` (tiles, tiles a second; Ryan, 2026-11-15). */
+      public static function burst(x:Number, y:Number, colors:Vector.<uint>, n:int, size:int,
+                                   vx:Number, vy:Number, spread:Number) : void
+      {
+         if (!viewing || colors == null || colors.length == 0 || n <= 0)
+         {
+            return;
+         }
+         var list:Array = [];
+         for (var i:int = 0; i < colors.length && i < 4; i++)
+         {
+            list.push(uint(colors[int(Math.random() * colors.length)]).toString(16));
+         }
+         send("burst " + fix(x) + " " + fix(y) + " " + Math.min(n, 12) + " " + size + " " + vx.toFixed(2) + " "
+            + vy.toFixed(2) + " " + spread.toFixed(2) + " " + list.join(","));
+      }
+
