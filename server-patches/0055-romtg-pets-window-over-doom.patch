          drawMyHealth(player, w);
          drawMyStatus(player, w, now);
 
+         // A dialog over Doom (the pets window, the potion storage...): what of this would draw
+         // over it hides behind it instead (Ryan, 2026-11-16: health and fame over the pets).
+         hideUnderDialog(w);
+
          // Status texts over you (+EXP, healing...): just above your health bar at the bottom,
          // where RotMG shows them over your character, rising and fading. Ones that came
          // together stack upwards.
@@ -360,6 +364,31 @@ package romtg
       private static var statusIcons:Sprite = null;
       private static var shownStatus:String = "";
 
+      /** Hides each part of the HUD that overlaps the open dialog (DoomLink.modalRect), as
+       *  RotMG's own dialogs cover its HUD; shows it again once it doesn't. */
+      private static function hideUnderDialog(w:Number) : void
+      {
+         var r:Rectangle = DoomLink.modalRect;
+         var cover:Rectangle = r != null ? new Rectangle(r.x + (w - 600), r.y, r.width, r.height) : null;
+         for each (var part:DisplayObject in [credits, myHealth, myHealthText, statusIcons, statuses, chat])
+         {
+            if (part == null)
+            {
+               continue;
+            }
+            var hidden:Boolean = false;
+            if (cover != null)
+            {
+               var was:Boolean = part.visible;
+               part.visible = true;   // (bounds of what it draws)
+               var b:Rectangle = part.getBounds(root);
+               hidden = b.width > 0 && b.height > 0 && b.intersects(cover);
+               part.visible = was;
+            }
+            part.alpha = hidden ? 0 : 1;
+         }
+      }
+
       /** Your status effect icons (slowed, blind, healing...), as RotMG shows them over your
        *  character (ConditionEffect.getConditionEffectIcons, the same frames), in a row over
        *  your health bar (Ryan, 2026-11-15: status effects in Doom). */
