+      /** `view X Y R`: the middle of RotMG's circle of ground (you) and its radius, in RotMG's
+       *  800x600 units of its window (as inRotmgUnits), when they change. */
+      private static function sendView(player:Player) : void
+      {
+         if (map == null || map.stage == null || player.posS_ == null || player.posS_.length < 2)
+         {
+            return;
+         }
+         var w:Number = map.stage.stageWidth, h:Number = map.stage.stageHeight;
+         var unit:Number = w / 800;
+         var left:Number = -(w - 800) / 2, top:Number = -(h - 600) / 2;
+         // The camera draws a tile 50 units wide in the map's own coordinates (Camera).
+         var c:Point = map.localToGlobal(new Point(player.posS_[0], player.posS_[1]));
+         var e:Point = map.localToGlobal(new Point(player.posS_[0] + 50 * VIEW_TILES, player.posS_[1]));
+         var line:String = "view " + ((c.x - left) / unit).toFixed(1) + " " + ((c.y - top) / unit).toFixed(1)
+            + " " + (Point.distance(c, e) / unit).toFixed(1);
+         if (line != viewSent)
+         {
+            viewSent = line;
+            send(line);
+         }
+      }
