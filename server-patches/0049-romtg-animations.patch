+     *  frames (ATTACK for ATTACK_PERIOD after it shoots, facing the shot unless it doesn't turn
+     *  for attacks; WALK while it moves, facing its way; else STAND): "ACTION FACING", 0 stand,
+     *  1 walk, 2 attack, FACING in world radians. */
+    public function doomAnim():String {
+        var t:int = getTimer();
+        if (t < this.attackStart_ + ATTACK_PERIOD) {
+            return "2 " + (this.props_.dontFaceAttacks_ ? this.facing_ : this.attackAngle_).toFixed(2);
+        }
+        if (this.moveVec_.x > ZERO_LIMIT || this.moveVec_.x < NEGATIVE_ZERO_LIMIT || this.moveVec_.y > ZERO_LIMIT || this.moveVec_.y < NEGATIVE_ZERO_LIMIT) {
+            return "1 " + Math.atan2(this.moveVec_.y, this.moveVec_.x).toFixed(2);
+        }
+        return "0 " + this.facing_.toFixed(2);
+    }
