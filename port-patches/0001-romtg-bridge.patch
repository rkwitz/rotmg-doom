diff --git a/src/romtg_bridge.cpp b/src/romtg_bridge.cpp
new file mode 100644
index 0000000..1e2bd62
--- /dev/null
+++ b/src/romtg_bridge.cpp
@@ -0,0 +1,193 @@
+// ROMTG-Doom: a line-based link from the mod's ZScript to the swapper (rotmg-doom/scripts/duo.py),
+// which relays the RotMG client. ZScript sees it as
+//
+//   struct RomtgBridge native
+//   {
+//       native static string Poll();         // next line from the swapper, "" when none
+//       native static void Send(string line); // one line to the swapper
+//       native static bool Connected();
+//   }
+//
+// A background thread keeps a TCP connection to ROMTGDOOM_BRIDGE_ADDR (default 127.0.0.1:2052),
+// retrying every second, and moves whole lines between the socket and two queues. Loopback only.
+
+#include <atomic>
+#include <chrono>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <cstdlib>
+#include <cstring>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+typedef SOCKET bridge_socket;
+#define BRIDGE_INVALID INVALID_SOCKET
+#define bridge_close closesocket
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+typedef int bridge_socket;
+#define BRIDGE_INVALID (-1)
+#define bridge_close close
+#endif
+
+#include "vm.h"
+
+namespace
+{
+	std::mutex lock;
+	std::deque<std::string> inbox, outbox;
+	std::atomic<bool> connected{ false };
+	std::once_flag started;
+
+	const size_t MAX_INBOX = 200000;	// lines; old ones are dropped if the mod stops reading
+
+	void Address(sockaddr_in &addr)
+	{
+		std::string host = "127.0.0.1";
+		int port = 2052;
+		if (const char *env = getenv("ROMTGDOOM_BRIDGE_ADDR"))
+		{
+			std::string value = env;
+			size_t colon = value.rfind(':');
+			if (colon != std::string::npos)
+			{
+				host = value.substr(0, colon);
+				port = atoi(value.c_str() + colon + 1);
+			}
+		}
+		memset(&addr, 0, sizeof(addr));
+		addr.sin_family = AF_INET;
+		addr.sin_port = htons((unsigned short)port);
+		// Loopback only, whatever the variable says.
+		if (inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1 || (ntohl(addr.sin_addr.s_addr) >> 24) != 127)
+			inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);
+	}
+
+	void Run()
+	{
+#ifdef _WIN32
+		WSADATA wsa;
+		WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+		sockaddr_in addr;
+		Address(addr);
+		std::string partial;
+		for (;;)
+		{
+			bridge_socket sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+			if (sock == BRIDGE_INVALID || connect(sock, (sockaddr *)&addr, sizeof(addr)) != 0)
+			{
+				if (sock != BRIDGE_INVALID) bridge_close(sock);
+				std::this_thread::sleep_for(std::chrono::seconds(1));
+				continue;
+			}
+			int one = 1;
+			setsockopt(sock, IPPROTO_TCP, TCP_NODELAY, (const char *)&one, sizeof(one));
+			{
+				std::lock_guard<std::mutex> guard(lock);
+				outbox.clear();
+				outbox.push_back("hello doom");
+			}
+			connected = true;
+			partial.clear();
+			for (;;)
+			{
+				// Out: everything queued.
+				std::string out;
+				{
+					std::lock_guard<std::mutex> guard(lock);
+					while (!outbox.empty())
+					{
+						out += outbox.front();
+						out += '\n';
+						outbox.pop_front();
+					}
+				}
+				bool failed = false;
+				for (size_t sent = 0; sent < out.size() && !failed;)
+				{
+					int n = send(sock, out.data() + sent, (int)(out.size() - sent), 0);
+					if (n <= 0) failed = true;
+					else sent += n;
+				}
+				if (failed) break;
+
+				// In: whatever arrives within 5 ms.
+				fd_set reads;
+				FD_ZERO(&reads);
+				FD_SET(sock, &reads);
+				timeval wait = { 0, 5000 };
+				int ready = select((int)sock + 1, &reads, nullptr, nullptr, &wait);
+				if (ready < 0) break;
+				if (ready == 0) continue;
+				char buffer[65536];
+				int n = recv(sock, buffer, sizeof(buffer), 0);
+				if (n <= 0) break;
+				partial.append(buffer, n);
+				size_t start = 0, end;
+				std::lock_guard<std::mutex> guard(lock);
+				while ((end = partial.find('\n', start)) != std::string::npos)
+				{
+					std::string line = partial.substr(start, end - start);
+					if (!line.empty() && line.back() == '\r') line.pop_back();
+					inbox.push_back(std::move(line));
+					start = end + 1;
+				}
+				partial.erase(0, start);
+				while (inbox.size() > MAX_INBOX) inbox.pop_front();
+			}
+			connected = false;
+			bridge_close(sock);
+			std::this_thread::sleep_for(std::chrono::seconds(1));
+		}
+	}
+
+	void Start()
+	{
+		std::call_once(started, [] { std::thread(Run).detach(); });
+	}
+}
+
+DEFINE_ACTION_FUNCTION(_RomtgBridge, Poll)
+{
+	PARAM_PROLOGUE;
+	Start();
+	std::string line;
+	{
+		std::lock_guard<std::mutex> guard(lock);
+		if (!inbox.empty())
+		{
+			line = std::move(inbox.front());
+			inbox.pop_front();
+		}
+	}
+	ACTION_RETURN_STRING(FString(line.c_str()));
+}
+
+DEFINE_ACTION_FUNCTION(_RomtgBridge, Send)
+{
+	PARAM_PROLOGUE;
+	PARAM_STRING(line);
+	Start();
+	if (connected)
+	{
+		std::lock_guard<std::mutex> guard(lock);
+		if (outbox.size() < 10000) outbox.push_back(line.GetChars());
+	}
+	return 0;
+}
+
+DEFINE_ACTION_FUNCTION(_RomtgBridge, Connected)
+{
+	PARAM_PROLOGUE;
+	Start();
+	ACTION_RETURN_BOOL(connected.load());
+}
