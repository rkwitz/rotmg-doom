# Copy to .env and fill in only what auto-detection gets wrong. Never commit .env.

# Folder holding this repo and the shared reference/ folder. Defaults to the repo's parent folder.
# ROMTGDOOM_WORKSPACE=C:\Users\you\Documents\game_modding

# Doom IWAD to play on (DOOM2.WAD from Steam/GOG, or freedoom2.wad). Only its engine basics are
# used: every picture in the mod comes from your own RotMG files.
# DOOM_IWAD=C:\Program Files (x86)\Steam\steamapps\common\Ultimate Doom\rerelease\DOOM2.WAD

# Local RotMG server checkout (made by `setup.py server`). Defaults to <repo>/server.
# ROTMG_SERVER_DIR=

# Harman AIR SDK used to compile the TKR client. Defaults to the newest <workspace>\tools\AIRSDK_*.
# ROMTGDOOM_AIR_SDK=C:\Users\you\Documents\game_modding\tools\AIRSDK_51.1.3

# Where the local RotMG server's game port listens. Never point this at the official servers.
# ROTMG_SERVER_ADDR=127.0.0.1:2050

# Bridge address between the RotMG side and the Doom port.
# ROMTGDOOM_BRIDGE_ADDR=127.0.0.1:47830
