# Machine-local settings
.env

# Checkouts made by setup, patched locally, never committed
port/
server/

# Build output
build/
doom-mod/*.pk3
bridge/target/
bridge/**/bin/
bridge/**/obj/

# Never commit game files, sprites or anything extracted from RotMG or Doom
reference/
*.wad
*.WAD
*.iwad
*.swf
*.pk3
assets-extracted/

# Editors and OS
.vs/
.vscode/
.idea/
*.user
.DS_Store
Thumbs.db
__pycache__/

# Logs from play runs
logs/
